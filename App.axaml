<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Termox.App"
             xmlns:local="using:Termox"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             Name="termox"
             RequestedThemeVariant="Dark">
             <!-- The app uses a custom dark workspace, so keep Fluent controls in dark mode on every OS. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!--
            Shared visual language for the workspace. Presentation-only, values below are
            centralized from whatever hex literal already dominated MainWindow.axaml for that
            role (not new color choices) so this pass doesn't recolor anything.
            Must stay ABOVE Application.Styles — Avalonia resolves StaticResource by document
            order, so a style declared before its resource fails at runtime (not at build time).
        -->
        <!-- Surfaces (distinct levels, darkest to lightest) -->
        <SolidColorBrush x:Key="TermoxPanelBrush" Color="#1e1e1e" />
        <SolidColorBrush x:Key="TermoxSurfaceBrush" Color="#252526" />
        <SolidColorBrush x:Key="TermoxSurfaceRaisedBrush" Color="#2d2d30" />
        <SolidColorBrush x:Key="TermoxSurfaceHoverBrush" Color="#30343b" />
        <SolidColorBrush x:Key="TermoxBorderBrush" Color="#444444" />

        <!-- Text -->
        <SolidColorBrush x:Key="TermoxTextPrimaryBrush" Color="#e0e0e0" />
        <SolidColorBrush x:Key="TermoxTextSecondaryBrush" Color="#aaaaaa" />
        <SolidColorBrush x:Key="TermoxMutedBrush" Color="#888888" />

        <!-- Accent / selection -->
        <SolidColorBrush x:Key="TermoxAccentBrush" Color="#4f9dde" />
        <SolidColorBrush x:Key="TermoxSelectionBrush" Color="#264f78" />

        <!-- Semantic (mirrors the successButton/dangerButton/warningButton/infoButton classes below) -->
        <SolidColorBrush x:Key="TermoxSuccessBrush" Color="#20a53a" />
        <SolidColorBrush x:Key="TermoxDangerBrush" Color="#dc3545" />
        <SolidColorBrush x:Key="TermoxWarningBrush" Color="#f39c12" />
        <SolidColorBrush x:Key="TermoxInfoBrush" Color="#17a2b8" />

        <!-- Modal scrim: standard weight for ordinary dialogs, heavy for the large File Preview modal -->
        <SolidColorBrush x:Key="TermoxModalScrimBrush" Color="#CC000000" />
        <SolidColorBrush x:Key="TermoxHeavyScrimBrush" Color="#B8000000" />

        <!-- Fonts -->
        <FontFamily x:Key="TermoxUiFontFamily">Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif</FontFamily>
        <FontFamily x:Key="TermoxMonoFontFamily">Consolas, Fira Code, Cascadia Code, Courier New, monospace</FontFamily>

        <!-- Modal title size (currently split 17/18/22/24px across dialogs for the same role) -->
        <system:Double x:Key="TermoxTitleFontSize">18</system:Double>

        <!-- Full-page tool tab header (Port Scanner, Ping Test, GPG Manager, etc.) -->
        <SolidColorBrush x:Key="TermoxPageTitleBrush" Color="#f1f1f1" />
        <SolidColorBrush x:Key="TermoxPageSubtitleBrush" Color="#999999" />
        <system:Double x:Key="TermoxPageTitleFontSize">24</system:Double>

        <FontFamily x:Key="MaterialIconFont">
            avares://Termox/Assets/Fonts#Material Icons
        </FontFamily>
        <SolidColorBrush x:Key="SvcSystems.UI.TerminalColor4" Color="#4F9DDE" />
        <SolidColorBrush x:Key="SvcSystems.UI.TerminalColor12" Color="#73B7FF" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.toolButton">
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#e5e7eb" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.toolButton:pointerover">        
            <Setter Property="Background" Value="#414750" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#6b7890" />
        </Style>
        <Style Selector="Button.toolButton:pressed">
            <Setter Property="Background" Value="#1769aa" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#4f9dde" />
        </Style>

        <!-- Full-width list row for the sidebar Tools panel — same colors as toolButton,
             stacked vertically instead of wrapped as chips, matching the Sessions/Bookmarks
             list rows elsewhere in the sidebar. -->
        <Style Selector="Button.toolListItem">
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#e5e7eb" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.toolListItem:pointerover">
            <Setter Property="Background" Value="#414750" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#6b7890" />
        </Style>
        <Style Selector="Button.toolListItem:pressed">
            <Setter Property="Background" Value="#1769aa" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#4f9dde" />
        </Style>

        <Style Selector="Button.primaryButton">
            <Setter Property="Background" Value="#007acc" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#3b9ee8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.primaryButton:pointerover">
            <Setter Property="Background" Value="#2185c5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="Button.primaryButton:pressed">
            <Setter Property="Background" Value="#0f4f82" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="Button.primaryButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.primaryButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.newConnectionButton">
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#f4f7fb" />
            <Setter Property="BorderBrush" Value="#4a5563" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.newConnectionButton:pointerover">
            <Setter Property="Background" Value="#1769aa" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4f9dde" />
        </Style>
        <Style Selector="Button.newConnectionButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.newConnectionButton:pressed">
            <Setter Property="Background" Value="#0f4f82" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="Button.newConnectionButton:pressed TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#151a22" />
            <Setter Property="Foreground" Value="#f3f5f7" />
            <Setter Property="PlaceholderForeground" Value="#8b95a5" />
            <Setter Property="CaretBrush" Value="#ffffff" />
            <Setter Property="SelectionBrush" Value="#1769aa" />
            <Setter Property="SelectionForegroundBrush" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#566173" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="#1c2330" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="PlaceholderForeground" Value="#a8b2c2" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#0b111a" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="PlaceholderForeground" Value="#a8b2c2" />
            <Setter Property="CaretBrush" Value="#ffffff" />
            <Setter Property="SelectionBrush" Value="#2f80c9" />
            <Setter Property="SelectionForegroundBrush" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="TextBox:disabled">
            <Setter Property="Background" Value="#242a33" />
            <Setter Property="Foreground" Value="#7f8896" />
            <Setter Property="PlaceholderForeground" Value="#6b7280" />
            <Setter Property="BorderBrush" Value="#3c4350" />
        </Style>
        <Style Selector="TextBox.connectionInput">
            <Setter Property="Padding" Value="9,8" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#151a22" />
            <Setter Property="Foreground" Value="#f3f5f7" />
            <Setter Property="PlaceholderForeground" Value="#8b95a5" />
            <Setter Property="BorderBrush" Value="#566173" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="Background" Value="#1c2330" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="PlaceholderForeground" Value="#a8b2c2" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="NumericUpDown:focus">
            <Setter Property="Background" Value="#0b111a" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="PlaceholderForeground" Value="#a8b2c2" />
            <Setter Property="BorderBrush" Value="#73b7ff" />
        </Style>
        <Style Selector="Button.neutralButton">
            <Setter Property="Background" Value="#3a3a3a" />
            <Setter Property="Foreground" Value="#f3f5f7" />
            <Setter Property="BorderBrush" Value="#555f6d" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.neutralButton:pointerover">
            <Setter Property="Background" Value="#586474" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#7b8798" />
        </Style>
        <Style Selector="Button.neutralButton:pressed">
            <Setter Property="Background" Value="#343b46" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#7b8798" />
        </Style>
        <Style Selector="Button.neutralButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.neutralButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.successButton">
            <Setter Property="Background" Value="{StaticResource TermoxSuccessBrush}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#4fc66a" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.successButton:pointerover">
            <Setter Property="Background" Value="#2eb85c" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#66d289" />
        </Style>
        <Style Selector="Button.successButton:pressed">
            <Setter Property="Background" Value="#16833a" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#66d289" />
        </Style>
        <Style Selector="Button.successButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.successButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.dangerButton">
            <Setter Property="Background" Value="{StaticResource TermoxDangerBrush}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#ef6672" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.dangerButton:pointerover">
            <Setter Property="Background" Value="#e04545" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#ff7373" />
        </Style>
        <Style Selector="Button.dangerButton:pressed">
            <Setter Property="Background" Value="#a42626" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#ff7373" />
        </Style>
        <Style Selector="Button.dangerButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.dangerButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.warningButton">
            <Setter Property="Background" Value="{StaticResource TermoxWarningBrush}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#f9bd4f" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.warningButton:pointerover">
            <Setter Property="Background" Value="#f7a928" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#ffd166" />
        </Style>
        <Style Selector="Button.warningButton:pressed">
            <Setter Property="Background" Value="#c77800" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#ffd166" />
        </Style>
        <Style Selector="Button.warningButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style Selector="Button.warningButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style Selector="Button.infoButton">
            <Setter Property="Background" Value="{StaticResource TermoxInfoBrush}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#55c7d8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.infoButton:pointerover">
            <Setter Property="Background" Value="#22abc2" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#68d7e8" />
        </Style>
        <Style Selector="Button.infoButton:pressed">
            <Setter Property="Background" Value="#117383" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#68d7e8" />
        </Style>
        <Style Selector="Button.infoButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.infoButton:pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.tableHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9aa4b0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tableHeader:pointerover">
            <Setter Property="Background" Value="#2d2d2d" />
            <Setter Property="Foreground" Value="#e0e0e0" />
        </Style>
        <Style Selector="Button.closeTabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#aeb7c4" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.closeTabBtn:pointerover">
            <Setter Property="Background" Value="#d32f2f" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#ef5350" />
        </Style>
        <Style Selector="Button.closeTabBtn:pressed">
            <Setter Property="Background" Value="#9f2323" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#ef5350" />
        </Style>

        <!-- Custom title bar's minimize/maximize/close: flush, transparent until hovered,
             fixed 46x40 so all three sit flat and even like a native caption-button row. -->
        <Style Selector="Button.windowControlBtn">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TermoxTextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.windowControlBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
        </Style>
        <!-- Two-class selector beats windowControlBtn's single-class :pointerover regardless
             of declaration order, so the close button keeps its red hover instead of the
             neutral one above. -->
        <Style Selector="Button.windowControlBtn.closeTabBtn:pointerover">
            <Setter Property="Background" Value="#d32f2f" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <!-- Icon-first sidebar nav rail (Sessions/Bookmarks/Tools/Chat). Flat, VS Code-style. -->
        <Style Selector="Button.sidebarRailButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TermoxMutedBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sidebarRailButton:pointerover">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.sidebarRailButton.active">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#007acc" />
        </Style>
        <Style Selector="Button.sidebarRailButton.active:pointerover">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#007acc" />
        </Style>

        <!-- Card grouping for sidebar content (list groups, button grids) — same border/radius
             language already used by the full-page tool tabs, reused here rather than invented. -->
        <Style Selector="Border.cardPanel">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#3a3a3a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!--
            Shared modal shell: every dialog in the app is a full-screen scrim behind a raised
            card. Centralizes the pattern that was previously hand-repeated at ~17 sites.
            Per-modal Width/Padding/MaxHeight/MaxWidth stay as instance overrides.
        -->
        <Style Selector="Border.modalScrim">
            <Setter Property="Background" Value="{StaticResource TermoxModalScrimBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.modalCard">
            <Setter Property="Background" Value="{StaticResource TermoxSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TermoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 10 30 0 #55000000" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Keep the terminal's ANSI palette readable on its near-black
            background.  Directory listings commonly use ANSI blue (color 4),
            which is too dark in the package default palette.
        -->
        <StyleInclude Source="avares://SvcSystems.UI.Terminal/Styles/Colors.axaml" />
        <!-- AvaloniaEdit styles (required for the text editor control). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Application.Styles>
</Application>
