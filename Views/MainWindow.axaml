<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Termox.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:terminal="using:SvcSystems.UI.Terminal"
    xmlns:edit="using:AvaloniaEdit"
    mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
    x:Class="Termox.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/Icons/termox-icon.png"
    Title="Termox — SSH &amp; SFTP Workspace"
    Width="1050" Height="700"
    Background="#2d2d30"
    FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Base Layout using DockPanel -->
        <DockPanel>

            <!-- Termox application menu -->
            <Menu DockPanel.Dock="Top" Background="#202124" Foreground="#e8eaed">
                <MenuItem Header="_Termox">
                    <MenuItem Header="About Termox"
                        Command="{Binding ShowAboutDialogCommand}" />
                    <Separator />
                    <MenuItem Header="Exit Termox" Click="ExitTermox_Click" />
                </MenuItem>
                <MenuItem Header="_Session">
                    <MenuItem Header="New Connection"
                        Command="{Binding ShowConnectionModalCommand}" />
                    <MenuItem Header="Disconnect Current Tab"
                        Command="{Binding DisconnectCommand}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="About Termox"
                        Command="{Binding ShowAboutDialogCommand}" />
                </MenuItem>
            </Menu>


            <!-- Status Bar at the bottom -->
            <Border DockPanel.Dock="Bottom" Background="#18527a" Padding="10,3">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" DockPanel.Dock="Left">
                        <TextBlock Text="●" Foreground="#6ee7a8" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Ready" Foreground="#f4f7fb" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="TERMOX  /  SSH WORKSPACE" Foreground="White" FontSize="12"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid ColumnDefinitions="280, 5, *">
                <!-- Sidebar (Sessions/Tools) -->
                <Border Grid.Column="0" Background="#252526" BorderBrush="#1e1e1e"
                    BorderThickness="0,0,1,0">
                    <TabControl Background="Transparent" Padding="0">
                        <TabControl.Styles>
                            <Style Selector="TabItem">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="MinHeight" Value="35" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ Border#PART_ContentPresenter">
                                <Setter Property="Background" Value="#30343b" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ Border#PART_ContentPresenter">
                                <Setter Property="Background" Value="#264f78" />
                            </Style>
                        </TabControl.Styles>

                        <TabItem Header="Sessions">
                            <ScrollViewer>
                                <StackPanel Margin="15" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="New Connection"
                                            Command="{Binding ShowConnectionModalCommand}"
                                            Background="#333337" Foreground="#e0e0e0" Padding="12,6"
                                            CornerRadius="4" FontSize="11"
                                            HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <TextBlock Text="Recently Used" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888" Margin="0,10,0,0"
                                        IsVisible="{Binding HasRecentlyUsedSessions}" />

                                    <ListBox ItemsSource="{Binding RecentlyUsedSessions}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        IsVisible="{Binding HasRecentlyUsedSessions}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *" Margin="0,4"
                                                    Background="Transparent"
                                                    ToolTip.Tip="{Binding Host}"
                                                    DoubleTapped="SavedSession_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectSftpProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <PathIcon Grid.Column="0"
                                                        Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                                        Width="14" Height="14" Foreground="#6ee7a8"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                            Foreground="#e0e0e0" FontSize="13"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Host}"
                                                            Foreground="#888888" FontSize="11"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Saved Sessions" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888" Margin="0,10,0,0" />

                                    <ListBox ItemsSource="{Binding SavedConnections}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *" Margin="0,4"
                                                    Background="Transparent"
                                                    ToolTip.Tip="{Binding Host}"
                                                    DoubleTapped="SavedSession_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectSftpProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteProfileCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <PathIcon Grid.Column="0"
                                                        Data="M4 4h16v12H5.17L4 17.17V4m0-2c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4zm10 10H6v-2h8v2z"
                                                        Width="16" Height="16" Foreground="#007acc"
                                                        Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                            Foreground="#e0e0e0" FontSize="13"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Host}"
                                                            Foreground="#888888" FontSize="11"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel IsVisible="{Binding !HasSavedConnections}" Spacing="4"
                                        Margin="4,12,4,0">
                                        <TextBlock Text="No saved sessions yet" Foreground="#c9d1db"
                                            FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="Create a connection to get started."
                                            Foreground="#858d98" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Bookmarks">
                            <ScrollViewer>
                                <StackPanel Margin="15" Spacing="10">

                                    <!-- Pinned / favorite bookmarks -->
                                    <TextBlock Text="⭐ Favorites" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888"
                                        IsVisible="{Binding HasFavoritedBookmarks}" />
                                    <ListBox ItemsSource="{Binding FavoritedBookmarks}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        IsVisible="{Binding HasFavoritedBookmarks}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,4"
                                                    Background="Transparent" ToolTip.Tip="{Binding Path}"
                                                    DoubleTapped="Bookmark_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu Background="#2d2d30" Foreground="#e0e0e0">
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkTerminalCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkSftpCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Remove Favorite"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleBookmarkFavoriteCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveBookmarkCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Button Grid.Column="0" Content="{Binding FavoriteGlyph}"
                                                        Click="ToggleBookmarkFavorite_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{Binding FavoriteColor}"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FavoriteToolTip}" />
                                                    <PathIcon Grid.Column="1"
                                                        Data="M17 3H5c-1.11 0-2 .9-2 2v16l7-3 7 3V5c0-1.1.89-2 2-2z"
                                                        Width="14" Height="14" Foreground="#f39c12"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SessionName}"
                                                            Foreground="#888888" FontSize="10"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="✕"
                                                        Click="RemoveBookmark_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#888"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Saved Bookmarks" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888" />
                                    <ListBox ItemsSource="{Binding Bookmarks}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,4"
                                                    Background="Transparent" ToolTip.Tip="{Binding Path}"
                                                    DoubleTapped="Bookmark_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu Background="#2d2d30" Foreground="#e0e0e0">
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkTerminalCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkSftpCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Add to Favorites"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleBookmarkFavoriteCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveBookmarkCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Button Grid.Column="0" Content="{Binding FavoriteGlyph}"
                                                        Click="ToggleBookmarkFavorite_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{Binding FavoriteColor}"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FavoriteToolTip}" />
                                                    <PathIcon Grid.Column="1"
                                                        Data="M17 3H5c-1.11 0-2 .9-2 2v16l7-3 7 3V5c0-1.1.89-2 2-2z"
                                                        Width="14" Height="14" Foreground="#f39c12"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SessionName}"
                                                            Foreground="#888888" FontSize="10"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="✕"
                                                        Click="RemoveBookmark_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#888"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel IsVisible="{Binding !HasBookmarks}" Spacing="4"
                                        Margin="4,12,4,0">
                                        <TextBlock Text="No bookmarks yet" Foreground="#c9d1db"
                                            FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="Bookmark a remote folder from SFTP."
                                            Foreground="#858d98" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Tools">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel Margin="15" Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                                    <Button Content="Port Scanner" Classes="toolButton"
                                        Command="{Binding OpenPortScannerTabCommand}"
                                        ToolTip.Tip="Open the dedicated port scanner tab" />
                                    <Button Content="Ping Test" Classes="toolButton"
                                        Command="{Binding OpenPingTestTabCommand}"
                                        ToolTip.Tip="Open the dedicated ping test tab" />
                                    <Button Content="SSH Key Generator" Classes="toolButton"
                                        Command="{Binding OpenSshKeyGeneratorTabCommand}"
                                        ToolTip.Tip="Open the dedicated SSH key generator tab" />
                                    <Button Content="Connection Tester" Classes="toolButton"
                                        Command="{Binding OpenConnectionTesterTabCommand}"
                                        ToolTip.Tip="Test all saved connections" />
                                    <Button Content="SSH Endpoint Test" Classes="toolButton"
                                        Command="{Binding OpenSshEndpointTestTabCommand}"
                                        ToolTip.Tip="Test SSH endpoint performance" />
                                    <Button Content="GPG Key Manager" Classes="toolButton"
                                        Command="{Binding OpenGpgTabCommand}"
                                        ToolTip.Tip="Manage GPG keys and export/import" />
                                    <Button Content="Fingerprint Utilities" Classes="toolButton"
                                        Command="{Binding OpenFingerprintTabCommand}"
                                        ToolTip.Tip="Calculate and compare file/text fingerprints" />
                                    <Button Content="DNS Inspector" Classes="toolButton"
                                        Command="{Binding OpenDnsTabCommand}"
                                        ToolTip.Tip="Inspect DNS records for domains" />
                                    <Button Content="Server Stats" Classes="toolButton"
                                        Command="{Binding OpenServerStatsTabCommand}"
                                        ToolTip.Tip="View CPU, memory, process, and disk stats over SSH" />
                                </WrapPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Background="#333" Width="5"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Terminal Area with Tab -->
                <Grid Grid.Column="2" Background="#1e1e1e">
                    <Border Background="#1e1e1e">
                        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
                                        FontSize="13" />
                                    <Button Content="✕"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseTabCommand}"
                                        CommandParameter="{Binding}" Classes="closeTabBtn"
                                        Foreground="#888" Background="Transparent"
                                        BorderThickness="0" Padding="2" FontSize="10"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.DataTemplates>
                            <DataTemplate DataType="vm:TerminalTabViewModel">
                                <Border Background="#0c0c0c" Padding="5">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,5">
                                            <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                                            <Button Grid.Column="1" Content="Reconnect"
                                                Command="{Binding ReconnectCommand}"
                                                IsVisible="{Binding IsReconnectAvailable}"
                                                Background="#3a3a3a" Foreground="White"
                                                Padding="12,5" CornerRadius="3" />
                                        </Grid>
                                        <terminal:TerminalControl Grid.Row="1" Model="{Binding TerminalModel}"
                                            FontFamily="Consolas, Fira Code, Cascadia Code, Courier New, monospace"
                                            FontSize="15"
                                            RightClickAction="CopyOrPaste"
                                            KeyDown="Terminal_KeyDown">
                                        <terminal:TerminalControl.ContextMenu>
                                            <ContextMenu Background="#2d2d30" Foreground="#e0e0e0"
                                                Opened="TerminalContextMenu_Opened">
                                                <MenuItem x:Name="TerminalCopyMenuItem" Header="Copy"
                                                    IsEnabled="False" Click="CopyMenu_Click">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"
                                                            Width="14" Height="14"
                                                            Foreground="#e0e0e0" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="TerminalPasteMenuItem" Header="Paste"
                                                    IsEnabled="False" Click="PasteMenu_Click" />
                                                <MenuItem Header="Duplicate SSH Terminal"
                                                    InputGesture="Ctrl+Shift+D"
                                                    Click="DuplicateTerminalMenu_Click" />
                                                <Separator />
                                                <MenuItem Header="Open SFTP"
                                                    Click="OpenSftpFromTerminal_Click" />
                                                <MenuItem Header="Add to Bookmarks"
                                                    Click="AddTerminalDirectoryBookmark_Click" />
                                            </ContextMenu>
                                        </terminal:TerminalControl.ContextMenu>
                                        </terminal:TerminalControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SftpTabViewModel">
                                <Border Background="#1e1e1e" Padding="10">
                                    <Panel>
                                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto"
                                            Margin="0,0,0,10">
                                            <Button Grid.Column="0" Content="↑"
                                                Command="{Binding NavigateUpCommand}"
                                                Margin="0,0,5,0" Background="#333" Foreground="#fff"
                                                ToolTip.Tip="Navigate to parent directory" />
                                            <TextBox Grid.Column="1" Text="{Binding CurrentPath}"
                                                Background="#252526" Foreground="#ccc"
                                                BorderThickness="1" BorderBrush="#444"
                                                IsReadOnly="False" VerticalContentAlignment="Center"
                                                KeyDown="SftpPathBox_KeyDown" />
                                            <Button Grid.Column="2" Content="⭐"
                                                Click="AddBookmark_Click" Margin="5,0,0,0"
                                                Background="#f39c12" Foreground="#fff"
                                                ToolTip.Tip="Add current path as bookmark" />
                                            <Button Grid.Column="3" Content="Refresh"
                                                Command="{Binding RefreshCommand}" Margin="5,0,0,0"
                                                Background="#333" Foreground="#fff"
                                                ToolTip.Tip="Reload directory contents" />
                                        </Grid>

                                        <!-- File actions stay directly below the address bar. -->
                                        <Grid Grid.Row="1"
                                            ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                                            Margin="0,0,0,10">
                                            <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Status}" Margin="0,0,10,0" />
                                            <Button Grid.Column="1"
                                                Click="UploadFile_Click" Background="#3a3a3a"
                                                Foreground="White" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Upload local files"
                                                Margin="0,0,3,0"
                                                IsVisible="{Binding !IsTransferring}" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE2C6;" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                Click="DownloadFile_Click"
                                                CommandParameter="{Binding #SftpListBox.SelectedItems}"
                                                Background="#3a3a3a" Foreground="White"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Download selected"
                                                IsEnabled="{Binding CanDownload}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE2C4;" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                Command="{Binding DeleteFileCommand}"
                                                Background="#3a3a3a" Foreground="White"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Delete selected file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE872;" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                Click="RenameFile_Click" Background="#3a3a3a"
                                                Foreground="White" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Rename file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE3C9;" />
                                            </Button>
                                            <Button Grid.Column="5"
                                                Click="EditFile_Click" Background="#3a3a3a"
                                                Foreground="White" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Edit selected file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE70F;" />
                                            </Button>
                                            <Button Grid.Column="6"
                                                Click="EditPermissions_Click" Background="#3a3a3a"
                                                Foreground="White" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Edit file permissions"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE897;" />
                                            </Button>
                                            <Button Grid.Column="7"
                                                Command="{Binding BulkDeleteCommand}"
                                                Background="#3a3a3a" Foreground="White"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Delete all selected files"
                                                IsEnabled="{Binding CanBulkDelete}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE92E;" />
                                            </Button>
                                            <Button Grid.Column="8"
                                                Content="{Binding PauseButtonText}"
                                                Command="{Binding TogglePauseCommand}"
                                                Background="#f39c12" Foreground="White"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                Margin="0,0,3,0"
                                                IsVisible="{Binding IsTransferring}" FontSize="12" />
                                            <Button Grid.Column="9" Content="Cancel Transfer"
                                                Command="{Binding CancelTransferCommand}"
                                                Background="#f44336" Foreground="White"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                IsVisible="{Binding IsTransferring}" FontSize="12" />
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto"
                                            Margin="0,0,0,10">
                                            <TextBox Grid.Column="0" Text="{Binding SearchQuery}"
                                                Background="#252526" Foreground="#ccc"
                                                BorderThickness="1" BorderBrush="#444" Padding="8"
                                                CornerRadius="4"
                                                PlaceholderText="🔍 Search files..."
                                                ToolTip.Tip="Filter files by name" />
                                        </Grid>

                                        <ListBox x:Name="SftpListBox" Grid.Row="3"
                                            ItemsSource="{Binding Files}"
                                            SelectedItem="{Binding SelectedFile}"
                                            SelectionMode="Multiple"
                                            SelectionChanged="SftpFileList_SelectionChanged"
                                            Background="#252526" BorderThickness="1"
                                            BorderBrush="#333"
                                            DoubleTapped="SftpFileList_DoubleTapped"
                                            KeyDown="SftpFileList_KeyDown">
                                            <ListBox.ContextMenu>
                                                <ContextMenu Background="#2d2d30"
                                                    Foreground="#e0e0e0">
                                                    <MenuItem Header="Download"
                                                        Click="ContextMenu_Download"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Upload"
                                                        Click="ContextMenu_Upload" />
                                                    <Separator />
                                                    <MenuItem Header="Rename"
                                                        Click="ContextMenu_Rename"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Delete"
                                                        Click="ContextMenu_Delete"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <Separator />
                                                    <MenuItem Header="Edit"
                                                        Click="ContextMenu_Edit"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Preview"
                                                        Click="ContextMenu_Preview"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Properties"
                                                        Click="ContextMenu_Properties"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <Separator />
                                                    <MenuItem Header="Add to Bookmarks"
                                                        Click="ContextMenu_AddBookmark" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="35, *, 90, 140, 110"
                                                        Margin="0,4">
                                                        <TextBlock Grid.Column="0"
                                                            Text="{Binding IconDisplay}"
                                                            FontSize="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                            Text="{Binding Name}"
                                                            Foreground="#e0e0e0"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                            Text="{Binding SizeDisplay}"
                                                            Foreground="#888" TextAlignment="Right"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                            Text="{Binding ModifiedDisplay}"
                                                            Foreground="#888"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4"
                                                            Text="{Binding Permissions}"
                                                            Foreground="#666"
                                                            FontFamily="Consolas, Fira Code, monospace"
                                                            FontSize="12" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </Grid>
                                    <Border Background="#CC000000" IsVisible="{Binding IsDeleteConfirmationVisible}"
                                        ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border Background="#2d2d30" BorderBrush="#555" BorderThickness="1"
                                            CornerRadius="8" Width="420" Padding="22"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Spacing="14">
                                                <TextBlock Text="Confirm Remote Delete" FontSize="17"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap"
                                                    Foreground="#ccc" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                                                        Background="#444" Foreground="#e0e0e0" Padding="14,7" />
                                                    <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                                                        Background="#d32f2f" Foreground="White" Padding="14,7" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <Border Background="#CC000000" IsVisible="{Binding IsFileSizeWarningVisible}"
                                        ZIndex="21" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border Background="#2d2d30" BorderBrush="#555" BorderThickness="1"
                                            CornerRadius="8" Width="440" Padding="22"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Spacing="14">
                                                <TextBlock Text="Large Download Warning" FontSize="17"
                                                    FontWeight="SemiBold" Foreground="#f39c12" />
                                                <TextBlock Text="{Binding FileSizeWarningMessage}" TextWrapping="Wrap"
                                                    Foreground="#ccc" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                    <Button Content="Cancel" Command="{Binding CancelFileSizeWarningCommand}"
                                                        Background="#444" Foreground="#e0e0e0" Padding="14,7" />
                                                    <Button Content="Download Anyway" Command="{Binding ConfirmFileSizeWarningCommand}"
                                                        Background="#f39c12" Foreground="White" Padding="14,7" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FileEditorTabViewModel">
                                <Border Background="#1e1e1e" Padding="10">
                                    <Panel>
                                        <Grid RowDefinitions="Auto, *">
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto"
                                                Margin="0,0,0,10">
                                                <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                    Foreground="{Binding StatusColor}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Status}" Margin="0,0,10,0" />
                                                <Button Grid.Column="1" Content="{Binding SaveButtonText}"
                                                    Command="{Binding SaveCommand}"
                                                    IsEnabled="{Binding IsDirty}"
                                                    Background="#3a3a3a" Foreground="White"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Save changes to remote file"
                                                    Margin="0,0,3,0" FontSize="12" />
                                                <Button Grid.Column="2" Content="Save &amp; Close"
                                                    Command="{Binding SaveAndCloseCommand}"
                                                    Background="#20a53a" Foreground="White"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Save changes and close this editor tab"
                                                    Margin="0,0,3,0" FontSize="12" />
                                                <Button Grid.Column="3" Content="✕"
                                                    Command="{Binding CloseTabCommand}"
                                                    Background="#f44336" Foreground="White"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Close editor (prompts if unsaved changes)"
                                                    FontSize="12" />
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <edit:TextEditor x:Name="Editor"
                                                    Document="{Binding Document}"
                                                    FontFamily="Consolas, Fira Code, Cascadia Code, Courier New, monospace"
                                                    FontSize="14"
                                                    ShowLineNumbers="True"
                                                    Background="#1e1e1e"
                                                    Foreground="#e0e0e0"
                                                    IsVisible="{Binding !IsLoading}" />
                                                <TextBlock Text="Loading remote file..."
                                                    Foreground="#888" FontSize="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLoading}" />
                                            </Grid>
                                        </Grid>
                                        <Border Background="#CC000000" IsVisible="{Binding IsSaveConfirmVisible}"
                                            ZIndex="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Border Background="#2d2d30" BorderBrush="#555" BorderThickness="1"
                                                CornerRadius="8" Width="420" Padding="22"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Unsaved Changes" FontSize="17"
                                                        FontWeight="SemiBold" Foreground="#f39c12" />
                                                    <TextBlock Text="This file has unsaved changes. Close without saving?"
                                                        TextWrapping="Wrap" Foreground="#ccc" />
                                                    <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Spacing="10">
                                                        <Button Content="Cancel"
                                                            Command="{Binding CancelDiscardCommand}"
                                                            Background="#444" Foreground="#e0e0e0"
                                                            Padding="14,7" />
                                                        <Button Content="Discard Changes"
                                                            Command="{Binding ConfirmDiscardCommand}"
                                                            Background="#d32f2f" Foreground="White"
                                                            Padding="14,7" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PortScannerTabViewModel">
                                <Grid Background="#1e1e1e" RowDefinitions="Auto,Auto,*">
                                    <Border Grid.Row="0" Background="#252526" Padding="28,24"
                                        BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Port Scanner" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Inspect TCP reachability across a host with clear, focused results."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#173c4a" CornerRadius="18"
                                                Padding="14,8" VerticalAlignment="Center">
                                                <TextBlock Text="TCP" Foreground="#5bd6e6"
                                                    FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>

        <Border Grid.Row="1" Margin="24,20,24,16" Padding="20"
            Background="#252526" BorderBrush="#3a3a3a"
            BorderThickness="1" CornerRadius="7">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="Scan configuration" Foreground="#e5e5e5"
                        FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Choose a saved session or localhost, then specify the TCP ports to inspect."
                        Foreground="#888" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="5">
                    <TextBlock Text="Target host" Foreground="#aaa"
                        FontSize="11" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding HostOptions}"
                        SelectedItem="{Binding SelectedHost}"
                        Background="#1e1e1e" Foreground="#e5e5e5"
                        BorderBrush="#555" Padding="10" MinHeight="44"
                        HorizontalContentAlignment="Stretch" CornerRadius="4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" Margin="2,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                        Foreground="#e5e5e5" FontSize="13" />
                                    <TextBlock Text="{Binding Host}"
                                        Foreground="#888" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Ports to scan" Foreground="#aaa"
                            FontSize="11" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ScanPorts}" PlaceholderText="22, 80, 443"
                            Background="#1e1e1e" Foreground="#e5e5e5"
                            BorderBrush="#555" Padding="10" CornerRadius="4" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Start Scan"
                        Command="{Binding ScanPortsCommand}"
                        Background="#007acc" Foreground="White"
                        Padding="22,9" CornerRadius="4" FontSize="12"
                        VerticalAlignment="Bottom" IsEnabled="{Binding !IsScanning}" />
                </Grid>

                <Border Grid.Row="3" Background="#1e1e1e" CornerRadius="4"
                    Padding="12,9" BorderBrush="#333" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="STATUS" Foreground="#777" FontSize="10"
                            FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ScanStatus}"
                            Foreground="#8fbed0" FontSize="12" Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

                                    <Border Grid.Row="2" Margin="24,0,24,24" Padding="20"
                                        Background="#252526" BorderBrush="#3a3a3a"
                                        BorderThickness="1" CornerRadius="7">
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Scan results" Foreground="#e5e5e5"
                                                        FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="Open ports are highlighted in green."
                                                        Foreground="#888" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ScanResults.Count, StringFormat='{}{0} results'}"
                                                    Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Grid.Row="1" Padding="12,8" Background="#1e1e1e">
                                            <Grid ColumnDefinitions="100,*,100"
                                                Background="#1e1e1e">
                                                <TextBlock Text="PORT" Foreground="#777" FontSize="10"
                                                    FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="PROTOCOL" Foreground="#777"
                                                    FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="STATUS" Foreground="#777"
                                                    FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            </Border>
                                            <ListBox Grid.Row="2" ItemsSource="{Binding ScanResults}"
                                                Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                                                MinHeight="260">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,9" BorderBrush="#2d2d2d"
                                                            BorderThickness="0,0,0,1">
                                                            <Grid ColumnDefinitions="100,*,100">
                                                                <TextBlock Text="{Binding Port}" Foreground="#ddd"
                                                                    FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="TCP"
                                                                    Foreground="#888" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                                    Foreground="{Binding StatusColor}"
                                                                    FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PingTestTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="760">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Ping Test" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Measure network reachability and round-trip response time for a host."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                                                        <TextBlock Text="Target host" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding PingHost}" PlaceholderText="example.com or 192.168.1.1"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" Padding="10" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                                        <TextBlock Text="Requests" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding PingCount}" Minimum="1" Maximum="10"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="1" Content="Start Ping"
                                                        Command="{Binding PingCommand}" Background="#007acc"
                                                        Foreground="White" Padding="22,9" CornerRadius="4"
                                                        VerticalAlignment="Bottom" IsEnabled="{Binding !IsPinging}" />
                                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="#1e1e1e" CornerRadius="4" Padding="12,9">
                                                        <TextBlock Text="Results appear below as replies arrive."
                                                            Foreground="#8fbed0" FontSize="12" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ListBox ItemsSource="{Binding PingResults}" Background="#1a1a1a"
                                                BorderThickness="1" BorderBrush="#333" MinHeight="180">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="80,*,Auto" Margin="12,8">
                                                            <TextBlock Text="{Binding Sequence, StringFormat='SEQ {0}'}"
                                                                Foreground="#ccc" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="TCP/IP echo response"
                                                                Foreground="#888" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Response}"
                                                                Foreground="{Binding ResponseColor}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SshKeyGeneratorTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="860">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="SSH Key Generator" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Create an OpenSSH key pair for secure remote access."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                                        <TextBlock Text="Key type" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <ComboBox ItemsSource="{Binding KeyTypes}"
                                                            SelectedItem="{Binding SelectedKeyType}"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" Padding="10" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Width="190" Spacing="5"
                                                        IsVisible="{Binding IsRsaKeySelected}">
                                                        <TextBlock Text="RSA key size" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding KeySize}" Minimum="1024" Maximum="4096"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="0" Content="Generate Key"
                                                        Command="{Binding GenerateKeyCommand}" Background="#007acc"
                                                        Foreground="White" Padding="22,9" CornerRadius="4"
                                                        HorizontalAlignment="Left" IsEnabled="{Binding !IsGeneratingKey}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Uses the system ssh-keygen command"
                                                        Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="#1e1e1e" CornerRadius="4" Padding="12,9">
                                                        <TextBlock Text="Private keys are generated locally and are never uploaded."
                                                            Foreground="#8fbed0" FontSize="12" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <TextBlock Text="Public key" Foreground="#aaa"
                                                        FontSize="11" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding GeneratedPublicKey}" Background="#1a1a1a"
                                                        Foreground="#e0e0e0" BorderBrush="#333" Padding="10"
                                                        Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="Consolas, Fira Code, monospace" FontSize="12" />
                                                    <Button Content="Copy Public Key" Command="{Binding CopyPublicKeyCommand}"
                                                        Background="#333337" Foreground="#e0e0e0" Padding="10,6"
                                                        CornerRadius="4" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="Private key" Foreground="#aaa"
                                                        FontSize="11" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding GeneratedPrivateKey}" Background="#1a1a1a"
                                                        Foreground="#e0e0e0" BorderBrush="#333" Padding="10"
                                                        Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="Consolas, Fira Code, monospace" FontSize="12" />
                                                    <Button Content="Copy Private Key" Command="{Binding CopyPrivateKeyCommand}"
                                                        Background="#333337" Foreground="#e0e0e0" Padding="10,6"
                                                        CornerRadius="4" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ConnectionTesterTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Connection Tester" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Verify connectivity for every saved SSH connection from one focused view."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Saved connection health" Foreground="#e5e5e5"
                                                            FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="Test host reachability and response time for your configured profiles."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Test All Connections"
                                                        Command="{Binding TestAllConnectionsCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="18,9" CornerRadius="4"
                                                        VerticalAlignment="Center" IsEnabled="{Binding !IsTesting}" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#1a1a1a" BorderBrush="#333"
                                                BorderThickness="1" CornerRadius="4" Padding="12,8">
                                                <Grid ColumnDefinitions="*,100,120">
                                                    <TextBlock Text="CONNECTION" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="STATUS" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="RESPONSE" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                            <ListBox ItemsSource="{Binding TestResults}" Background="#1a1a1a"
                                                BorderThickness="1" BorderBrush="#333" MinHeight="240">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10" BorderBrush="#2d2d2d"
                                                            BorderThickness="0,0,0,1">
                                                            <Grid ColumnDefinitions="*,100,120">
                                                                <TextBlock Text="{Binding ProfileName}" Foreground="#e0e0e0"
                                                                    FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                                    Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ResponseTime}"
                                                                    Foreground="#888" FontSize="11" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SshEndpointTestTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="860">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="SSH Endpoint Test" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Measure the responsiveness of an SSH endpoint over an authenticated SFTP session."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                                                        <TextBlock Text="Target host" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding SpeedTestHost}" PlaceholderText="hostname or IP address"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" Padding="10" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                        Text="The endpoint test reports connection latency and SFTP benchmarking requirements."
                                                        Foreground="#8fbed0" FontSize="12" VerticalAlignment="Center" />
                                                    <Button Grid.Row="1" Grid.Column="1" Content="Test SSH Endpoint"
                                                        Command="{Binding RunSpeedTestCommand}" Background="#007acc"
                                                        Foreground="White" Padding="18,9" CornerRadius="4"
                                                        IsEnabled="{Binding !IsSpeedTesting}" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#1a1a1a" BorderBrush="#333"
                                                BorderThickness="1" CornerRadius="4" Padding="16" MinHeight="180">
                                                <TextBlock Text="{Binding SpeedTestResult}" Foreground="#ccc"
                                                    TextWrapping="Wrap" FontFamily="Consolas, Fira Code, monospace"
                                                    FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:GpgTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="GPG Key Manager" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Manage your GPG keys, view details, export, and import keys."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Refresh Keys" 
                                                            Command="{Binding RefreshKeysCommand}"
                                                            Background="#007acc" Foreground="White"
                                                            Padding="14,8" CornerRadius="4"
                                                            IsEnabled="{Binding !IsLoading}" />
                                                        <Button Content="Import Key"
                                                            Command="{Binding ShowImportModalCommand}"
                                                            Background="#28a745" Foreground="White"
                                                            Padding="14,8" CornerRadius="4"
                                                            IsEnabled="{Binding !IsLoading}" />
                                                        <TextBlock Text="{Binding Status}"
                                                            Foreground="{Binding StatusColor}"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            Margin="20,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Public Keys" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding PublicKeys}"
                                                    SelectedItem="{Binding SelectedPublicKey}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8"
                                                    MinHeight="120">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3">
                                                                <Grid RowDefinitions="Auto,Auto,Auto">
                                                                    <TextBlock Grid.Row="0"
                                                                        Text="{Binding UserId}" Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                        Text="{Binding KeyId, StringFormat='Key ID: {0}'}"
                                                                        Foreground="#999" FontSize="11"
                                                                        Margin="0,4,0,0" />
                                                                    <TextBlock Grid.Row="2"
                                                                        Text="{Binding CreatedDate, StringFormat='Created: {0}'}"
                                                                        Foreground="#666" FontSize="11"
                                                                        Margin="0,2,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Export Public Key"
                                                        Command="{Binding ExportPublicKeyCommand}"
                                                        Background="#17a2b8" Foreground="White"
                                                        Padding="12,6" CornerRadius="4"
                                                        IsEnabled="{Binding CanExportKey}" />
                                                    <Button Content="Delete Key"
                                                        Command="{Binding DeleteKeyCommand}"
                                                        Background="#dc3545" Foreground="White"
                                                        Padding="12,6" CornerRadius="4"
                                                        IsEnabled="{Binding CanDeleteKey}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Secret Keys" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding SecretKeys}"
                                                    SelectedItem="{Binding SelectedSecretKey}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8"
                                                    MinHeight="100">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3">
                                                                <Grid RowDefinitions="Auto,Auto">
                                                                    <TextBlock Grid.Row="0"
                                                                        Text="{Binding UserId}" Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                        Text="{Binding KeyId, StringFormat='Key ID: {0}'}"
                                                                        Foreground="#999" FontSize="11"
                                                                        Margin="0,4,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Content="Export Secret Key"
                                                    Command="{Binding ExportSecretKeyCommand}"
                                                    Background="#ffc107" Foreground="#000"
                                                    Padding="12,6" CornerRadius="4"
                                                    IsEnabled="{Binding CanExportSecretKey}" />
                                            </StackPanel>
                                            <!-- Import Modal -->
                                            <Border Background="#CC000000" IsVisible="{Binding IsImportModalVisible}"
                                                ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Border Background="#2d2d30" BorderBrush="#555" BorderThickness="1"
                                                    CornerRadius="8" Width="600" Padding="22"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Spacing="14">
                                                        <TextBlock Text="Import GPG Key" FontSize="17"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Paste the ASCII-armored key data below:"
                                                            Foreground="#ccc" FontSize="12" />
                                                        <TextBox Text="{Binding ImportKeyData}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" Padding="10"
                                                            MinHeight="200" TextWrapping="Wrap"
                                                            AcceptsReturn="True" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                            <Button Content="Cancel" 
                                                                Command="{Binding CloseImportModalCommand}"
                                                                Background="#444" Foreground="#e0e0e0" Padding="14,7" />
                                                            <Button Content="Import" 
                                                                Command="{Binding ImportKeyCommand}"
                                                                Background="#28a745" Foreground="White" Padding="14,7"
                                                                IsEnabled="{Binding !IsLoading}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <!-- Export Modal -->
                                            <Border Background="#CC000000" IsVisible="{Binding IsExportModalVisible}"
                                                ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Border Background="#2d2d30" BorderBrush="#555" BorderThickness="1"
                                                    CornerRadius="8" Width="700" Padding="22"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Spacing="14">
                                                        <TextBlock Text="Exported Key" FontSize="17"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBox Text="{Binding ExportedKeyData}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" Padding="10"
                                                            MinHeight="250" TextWrapping="Wrap"
                                                            AcceptsReturn="True" IsReadOnly="True" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                            <Button Content="Copy to Clipboard"
                                                                Command="{Binding CopyExportedKeyCommand}"
                                                                Background="#17a2b8" Foreground="White" Padding="14,7" />
                                                            <Button Content="Close"
                                                                Command="{Binding CloseExportModalCommand}"
                                                                Background="#444" Foreground="#e0e0e0" Padding="14,7" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FingerprintTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Fingerprint Utilities" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Calculate and compare file or text fingerprints using various hash algorithms."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                                    RowSpacing="12" ColumnSpacing="12">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Algorithm:"
                                                        Foreground="#aaa" VerticalAlignment="Center"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                                        ItemsSource="{Binding SupportedAlgorithms}"
                                                        SelectedItem="{Binding SelectedAlgorithm}"
                                                        Background="#1e1e1e" Foreground="#e0e0e0"
                                                        BorderBrush="#555" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Text:"
                                                        Foreground="#aaa" VerticalAlignment="Top"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Grid.Row="1" Grid.Column="1"
                                                        Text="{Binding InputText}" PlaceholderText="Enter text or paste content"
                                                        Background="#1e1e1e" Foreground="#e0e0e0"
                                                        BorderBrush="#555" Padding="10"
                                                        MinHeight="100" TextWrapping="Wrap"
                                                        AcceptsReturn="True" />
                                                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                                        Content="Calculate Fingerprint"
                                                        Command="{Binding CalculateFingerprintCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="14,8" CornerRadius="4"
                                                        IsEnabled="{Binding !IsCalculating}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Calculated Fingerprints" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <Border Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel>
                                                            <TextBlock Text="Raw (uppercase hex):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding CalculatedFingerprint}"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopyCalculatedCommand}"
                                                                Background="#444" Foreground="#e0e0e0"
                                                                Padding="10,4" CornerRadius="3" Margin="0,4,0,0"
                                                                HorizontalAlignment="Left" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Formatted (pairs):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding FormattedFingerprint}"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopyFormattedCommand}"
                                                                Background="#444" Foreground="#e0e0e0"
                                                                Padding="10,4" CornerRadius="3" Margin="0,4,0,0"
                                                                HorizontalAlignment="Left" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="SSH Style (colons):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SshStyleFingerprint}"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopySshStyleCommand}"
                                                                Background="#444" Foreground="#e0e0e0"
                                                                Padding="10,4" CornerRadius="3" Margin="0,4,0,0"
                                                                HorizontalAlignment="Left" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Compare Fingerprints" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <Border Background="#252526" BorderBrush="#3a3a3a"
                                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*"
                                                        RowSpacing="10">
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Expected Fingerprint:" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding ExpectedFingerprint}"
                                                                PlaceholderText="Paste expected fingerprint here"
                                                                Background="#1e1e1e" Foreground="#e0e0e0"
                                                                BorderBrush="#555" Padding="10"
                                                                MinHeight="60" TextWrapping="Wrap"
                                                                AcceptsReturn="True" />
                                                        </StackPanel>
                                                        <Button Grid.Row="1"
                                                            Content="Compare Fingerprints"
                                                            Command="{Binding CompareFingerprintsCommand}"
                                                            Background="#007acc" Foreground="White"
                                                            Padding="14,8" CornerRadius="4"
                                                            HorizontalAlignment="Left" />
                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{Binding ComparisonStatus}"
                                                                Foreground="{Binding ComparisonStatusColor}"
                                                                FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="Clear All"
                                                Command="{Binding ClearCommand}"
                                                Background="#6c757d" Foreground="White"
                                                Padding="14,8" CornerRadius="4"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DnsTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="DNS Record Inspector" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="Query and inspect DNS records (A, AAAA, CNAME, MX, TXT, NS, SOA, SRV, PTR, CAA) for any domain."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*"
                                                        RowSpacing="10" ColumnSpacing="12">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Domain:"
                                                            Foreground="#aaa" VerticalAlignment="Center"
                                                            FontSize="12" FontWeight="SemiBold" />
                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                            Text="{Binding DomainName}" PlaceholderText="e.g., example.com"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" Padding="10" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Record Type:"
                                                            Foreground="#aaa" VerticalAlignment="Center"
                                                            FontSize="12" FontWeight="SemiBold" />
                                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                            ItemsSource="{Binding SupportedRecordTypes}"
                                                            SelectedItem="{Binding SelectedRecordType}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Query Record Type"
                                                            Command="{Binding QueryDnsCommand}"
                                                            Background="#007acc" Foreground="White"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsQuerying}"
                                                            HorizontalAlignment="Left" />
                                                        <Button Content="Query All Record Types"
                                                            Command="{Binding QueryAllCommand}"
                                                            Background="#28a745" Foreground="White"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsQuerying}"
                                                            HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                        FontSize="12" TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Status}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Query Results" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding QueryResults}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8" MinHeight="150">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3" Margin="0,2">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding RecordType, StringFormat='[{0}]'}"
                                                                        Foreground="#4caf50" FontWeight="SemiBold"
                                                                        Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DisplayText}"
                                                                        Foreground="#e0e0e0" TextWrapping="Wrap" />
                                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Detailed Results" FontSize="14"
                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                <Border Background="#252526" BorderBrush="#333"
                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                    <Grid RowDefinitions="*,Auto">
                                        <TextBox Grid.Row="0"
                                            Text="{Binding DetailedResult}"
                                            Background="#1e1e1e" Foreground="#4caf50"
                                            BorderBrush="#333" Padding="10"
                                            MinHeight="180" TextWrapping="Wrap"
                                            AcceptsReturn="True" IsReadOnly="True"
                                            FontFamily="Consolas, Fira Code, monospace"
                                            FontSize="11" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Copy Results"
                                                Command="{Binding CopyResultCommand}"
                                                Background="#17a2b8" Foreground="White"
                                                Padding="12,6" CornerRadius="4" FontSize="11" />
                                            <Button Content="Clear"
                                                Command="{Binding ClearResultsCommand}"
                                                Background="#6c757d" Foreground="White"
                                                Padding="12,6" CornerRadius="4" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DataTemplate>

                            <DataTemplate DataType="vm:ServerStatsTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="1100">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Server Stats" FontSize="24"
                                                    FontWeight="SemiBold" Foreground="#f1f1f1" />
                                                <TextBlock Text="CPU, memory, top processes, and disk usage collected over SSH from a saved session."
                                                    Foreground="#999" FontSize="13" />
                                            </StackPanel>

                                            <!-- Host selection -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <TextBlock Text="Host:" Foreground="#aaa"
                                                            VerticalAlignment="Center" FontSize="12"
                                                            FontWeight="SemiBold" />
                                                        <ComboBox Grid.Column="1"
                                                            ItemsSource="{Binding HostProfiles}"
                                                            SelectedItem="{Binding SelectedProfile}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" Padding="10"
                                                            HorizontalContentAlignment="Stretch">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="2" Margin="2,3">
                                                                        <TextBlock Text="{Binding Name}"
                                                                            Foreground="#e5e5e5" FontSize="13" />
                                                                        <TextBlock Text="{Binding Host}"
                                                                            Foreground="#888" FontSize="11" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Collect Stats"
                                                            Command="{Binding CollectStatsCommand}"
                                                            Background="#007acc" Foreground="White"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsCollecting}"
                                                            HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Status}"
                                                            Foreground="{Binding StatusColor}"
                                                            FontSize="12" VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding Status}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- System overview -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="System Overview" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Grid ColumnDefinitions="110,*,110,*,110,*" RowDefinitions="Auto,Auto"
                                                        RowSpacing="10" ColumnSpacing="8">
                                                        <TextBlock Text="OS" Foreground="#888" FontSize="11"
                                                            FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding OsInfo}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding OsInfo}" />
                                                        <TextBlock Grid.Column="2" Text="Kernel" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Kernel}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="Host" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Host}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="1" Text="Uptime" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Uptime}"
                                                            Foreground="#e0e0e0" FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Load Avg"
                                                            Foreground="#888" FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LoadAverage}"
                                                            Foreground="#e0e0e0" FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="CPU" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="5"
                                                            Text="{Binding CpuUsageDisplay}"
                                                            Foreground="{Binding CpuUsageColor}"
                                                            FontSize="14" FontWeight="SemiBold" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Summary strip: CPU / Memory / Disk -->
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                                <Border Background="#252526" BorderBrush="#3a3a3a"
                                                    BorderThickness="1" CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="CPU" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding CpuUsageDisplay}"
                                                                Foreground="{Binding CpuUsageColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#007acc"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding CpuBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding CpuSummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="#252526"
                                                    BorderBrush="#3a3a3a" BorderThickness="1"
                                                    CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Memory" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding MemoryUsedDisplay}"
                                                                Foreground="{Binding MemoryUsedColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#f39c12"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding MemoryBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding MemorySummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="#252526"
                                                    BorderBrush="#3a3a3a" BorderThickness="1"
                                                    CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Disk" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding DiskUsedDisplay}"
                                                                Foreground="{Binding DiskUsedColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#4caf50"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding DiskBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DiskSummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Top CPU processes table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Top CPU Processes" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Shows the top 20 processes fetched over SSH."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="60,90,90,90,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="pid"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="PID" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding CpuIndicatorPid}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="User"
                                                                Classes="tableHeader" />
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="cpu"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="CPU %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding CpuIndicatorCpu}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="memory"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Mem %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding CpuIndicatorMemory}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="name"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Command" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding CpuIndicatorName}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding TopCpuProcesses}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="180" MaxHeight="380">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="60,90,90,90,*">
                                                                        <TextBlock Text="{Binding Pid}" Foreground="#888"
                                                                            FontSize="11" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding User}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2"
                                                                            Text="{Binding CpuPercentDisplay}"
                                                                            Foreground="#4caf50" FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding MemPercentDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Command}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip.Tip="{Binding Command}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Top memory processes table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Top Memory Processes" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Shows the top 20 processes fetched over SSH."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="60,90,90,90,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="pid"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="PID" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding MemoryIndicatorPid}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="User"
                                                                Classes="tableHeader" />
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="memory"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Memory" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding MemoryIndicatorMemory}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="cpu"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Mem %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding MemoryIndicatorCpu}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="name"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Command" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding MemoryIndicatorName}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding TopMemoryProcesses}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="180" MaxHeight="380">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="60,90,90,90,*">
                                                                        <TextBlock Text="{Binding Pid}" Foreground="#888"
                                                                            FontSize="11" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding User}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2"
                                                                            Text="{Binding RssDisplay}"
                                                                            Foreground="#f39c12" FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding MemPercentDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Command}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip.Tip="{Binding Command}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Disk usage table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Disk Usage" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Sizes are shown in human-readable units."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="110,90,90,90,70,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Filesystem"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Filesystem" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding DiskIndicatorFilesystem}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Size"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Size" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorSize}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Used"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Used" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorUsed}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Available"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Available" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorAvailable}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="UsePercent"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Use %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorUsePercent}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="5" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="MountedOn"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Mounted On" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding DiskIndicatorMountedOn}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding Disks}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="150" MaxHeight="320">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="110,90,90,90,70,*">
                                                                        <TextBlock Text="{Binding Filesystem}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding UsedDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding AvailableDisplay}"
                                                                            Foreground="#4caf50" FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4"
                                                                            Text="{Binding UsePercentDisplay}"
                                                                            Foreground="#f39c12" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="5"
                                                                            Text="{Binding MountedOn}"
                                                                            Foreground="#888" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ToolsTabViewModel">
                                <TabControl Background="#1e1e1e" Padding="0">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="MinHeight" Value="39" />
                                            <Setter Property="Padding" Value="5,5,5,7" />
                                            <Setter Property="Foreground" Value="#888888" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border Background="Transparent"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            BorderBrush="{TemplateBinding BorderBrush}">
                                                            <ContentPresenter Name="PART_Content"
                                                                Content="{TemplateBinding Header}"
                                                                RecognizesAccessKey="True"
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style Selector="TabItem:selected">
                                            <Setter Property="Foreground" Value="#e0e0e0" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Setter Property="BorderBrush" Value="#007acc" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabItem Header="Port Scanner" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Port Scanner" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Scan Host" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding ScanHost}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        Margin="0,0,0,10" />
                                                    <TextBlock Text="Ports (comma-separated)"
                                                        Foreground="#aaaaaa" FontSize="12"
                                                        FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding ScanPorts}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Start Scan"
                                                        Command="{Binding ScanPortsCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsScanning}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding ScanResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="Auto, *, Auto"
                                                                    Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding Port}"
                                                                        Foreground="#ccc"
                                                                        FontWeight="SemiBold"
                                                                        Width="50" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text=" - " Foreground="#888" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding Status}"
                                                                        Foreground="{Binding StatusColor}"
                                                                        FontWeight="SemiBold" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Ping Test" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Ping Test" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Target Host"
                                                        Foreground="#aaaaaa" FontSize="12"
                                                        FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding PingHost}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        Margin="0,0,0,10" />
                                                    <TextBlock Text="Count" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <NumericUpDown Value="{Binding PingCount}"
                                                        Minimum="1" Maximum="10"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Start Ping"
                                                        Command="{Binding PingCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsPinging}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding PingResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="Auto, *, Auto"
                                                                    Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding Sequence}"
                                                                        Foreground="#ccc"
                                                                        FontWeight="SemiBold"
                                                                        Width="30" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="seq" Foreground="#888" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding Response}"
                                                                        Foreground="{Binding ResponseColor}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="SSH Key Generator" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="SSH Key Generator"
                                                        FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Key Type" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <ComboBox ItemsSource="{Binding KeyTypes}"
                                                        SelectedItem="{Binding SelectedKeyType}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        Margin="0,0,0,10">
                                                    </ComboBox>
                                                    <StackPanel Spacing="6"
                                                        IsVisible="{Binding IsRsaKeySelected}">
                                                        <TextBlock Text="Key Size (RSA only)"
                                                            Foreground="#aaaaaa" FontSize="12"
                                                            FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding KeySize}"
                                                            Minimum="1024" Maximum="4096"
                                                            Background="#252526"
                                                            Foreground="#e0e0e0"
                                                            Margin="0,0,0,10" />
                                                    </StackPanel>
                                                    <Button Content="Generate Key"
                                                        Command="{Binding GenerateKeyCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsGeneratingKey}"
                                                        HorizontalAlignment="Left" />
                                                    <TextBlock Text="Public Key"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold"
                                                        Margin="0,6,0,0" />
                                                    <TextBox Text="{Binding GeneratedPublicKey}"
                                                        Background="#1a1a1a" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#333"
                                                        Padding="8" CornerRadius="4" Height="60"
                                                        IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="Consolas, Fira Code, monospace"
                                                        FontSize="12" />
                                                    <Button Content="Copy Public Key"
                                                        Command="{Binding CopyPublicKeyCommand}"
                                                        Background="#333337" Foreground="#e0e0e0"
                                                        Padding="10,6" CornerRadius="4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Left" />
                                                    <TextBlock Text="Private Key"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold"
                                                        Margin="0,6,0,0" />
                                                    <TextBox Text="{Binding GeneratedPrivateKey}"
                                                        Background="#1a1a1a" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#333"
                                                        Padding="8" CornerRadius="4" Height="120"
                                                        IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="Consolas, Fira Code, monospace"
                                                        FontSize="12" />
                                                    <Button Content="Copy Private Key"
                                                        Command="{Binding CopyPrivateKeyCommand}"
                                                        Background="#333337" Foreground="#e0e0e0"
                                                        Padding="10,6" CornerRadius="4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Connection Tester" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Connection Tester"
                                                        FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock
                                                        Text="Batch test all saved connections for connectivity."
                                                        Foreground="#aaaaaa" FontSize="12" />
                                                    <Button Content="Test All Connections"
                                                        Command="{Binding TestAllConnectionsCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsTesting}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding TestResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="400">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="*, Auto, Auto"
                                                                    Margin="0,3" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding ProfileName}"
                                                                        Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding Status}"
                                                                        Foreground="{Binding StatusColor}"
                                                                        FontWeight="SemiBold"
                                                                        Width="80" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding ResponseTime}"
                                                                        Foreground="#888"
                                                                        FontSize="11"
                                                                        Width="120" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="SSH Endpoint Test" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Speed Test" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock
                                                        Text="Test upload/download speeds over SFTP."
                                                        Foreground="#aaaaaa" FontSize="12" />
                                                    <TextBlock Text="Target Host"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding SpeedTestHost}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        PlaceholderText="hostname or IP"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Test SSH Endpoint"
                                                        Command="{Binding RunSpeedTestCommand}"
                                                        Background="#007acc" Foreground="White"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsSpeedTesting}"
                                                        HorizontalAlignment="Left" />
                                                    <Border Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" CornerRadius="4"
                                                        Padding="10">
                                                        <TextBlock Text="{Binding SpeedTestResult}"
                                                            Foreground="#ccc" TextWrapping="Wrap"
                                                            FontFamily="Consolas, Fira Code, monospace"
                                                            FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DataTemplate>
                        </TabControl.DataTemplates>
                        </TabControl>
                    </Border>
                    <Border IsVisible="{Binding !HasTabs}" Background="#1e1e1e">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" Width="360">
                            <Image Source="/Assets/Icons/termox-icon.png" Width="72" Height="72"
                                HorizontalAlignment="Center" Opacity="0.9" />
                            <TextBlock Text="Welcome to Termox" Foreground="#f1f5f9"
                                FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Your secure SSH and SFTP workspace"
                                Foreground="#9aa4b2" FontSize="13" HorizontalAlignment="Center" />
                            <Button Content="＋  New Connection"
                                Command="{Binding ShowConnectionModalCommand}"
                                Classes="primaryButton" Padding="18,10"
                                HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Double-click a saved session to open it, or use the Tools tab for network utilities."
                                Foreground="#737d8a" FontSize="11" TextWrapping="Wrap"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <Border Background="#2d2d30" BorderBrush="#f39c12" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="20" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" MaxWidth="520" ZIndex="200"
            IsVisible="{Binding IsEditorStatusVisible}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding EditorStatusMessage}" Foreground="#f5f5f5"
                    TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕"
                    Command="{Binding ClearEditorStatusCommand}"
                    Background="Transparent" Foreground="#aaa" BorderThickness="0" />
            </Grid>
        </Border>

        <!-- Connection Modal Overlay -->
        <Border Background="#99000000" IsVisible="{Binding IsConnectionModalVisible}" ZIndex="100">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="450" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <Border Padding="16">
                    <StackPanel Spacing="15">
                        <Grid>
                            <TextBlock Text="New Connection Profile" FontWeight="Bold" FontSize="18"
                                Foreground="#e0e0e0" VerticalAlignment="Center" />
                            <Button Content="✕" Command="{Binding HideConnectionModalCommand}"
                                Background="Transparent" Foreground="#888"
                                HorizontalAlignment="Right"
                                FontSize="16" BorderThickness="0" />
                        </Grid>

                        <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                        <TextBlock Text="SERVER" Foreground="#6ea9d4" FontSize="10"
                            FontWeight="Bold" LetterSpacing="1.2" />
                        <TextBlock Text="Connection Name" Foreground="#aaaaaa" FontSize="13" />
                        <TextBox Text="{Binding ConnectionName}" Background="#1e1e1e"
                            Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555" Padding="8"
                            CornerRadius="4" PlaceholderText="My Server" />

                        <TextBlock Text="Remote Host" Foreground="#aaaaaa" FontSize="13"
                            Margin="0,5,0,0" />
                        <TextBox Text="{Binding Host}" Background="#1e1e1e" Foreground="#e0e0e0"
                            BorderThickness="1" BorderBrush="#555" Padding="8" CornerRadius="4"
                            PlaceholderText="e.g., example.com" />

                        <Grid ColumnDefinitions="*, 15, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Username" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding Username}" Background="#1e1e1e"
                                    Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555"
                                    Padding="8" CornerRadius="4" PlaceholderText="user" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Port" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding Port}" Background="#1e1e1e"
                                    Foreground="#e0e0e0"
                                    BorderThickness="1" BorderBrush="#555" Padding="8"
                                    CornerRadius="4"
                                    PlaceholderText="22" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="AUTHENTICATION" Foreground="#6ea9d4" FontSize="10"
                            FontWeight="Bold" LetterSpacing="1.2" Margin="0,5,0,0" />
                        <TextBlock Text="Password" Foreground="#aaaaaa" FontSize="13"
                            Margin="0,5,0,0" />
                        <TextBox Text="{Binding Password}" Background="#1e1e1e" Foreground="#e0e0e0"
                            BorderThickness="1" BorderBrush="#555" Padding="8" CornerRadius="4"
                            PasswordChar="•" ToolTip.Tip="Leave blank if key has no password" />

                        <TextBlock Text="Private Key File (Optional)" Foreground="#aaaaaa"
                            FontSize="13"
                            Margin="0,5,0,0" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath}"
                                Background="#1e1e1e" Foreground="#e0e0e0" BorderThickness="1"
                                BorderBrush="#555" Padding="8" CornerRadius="4"
                                PlaceholderText="/path/to/id_rsa" />
                            <Button Grid.Column="1" Content="Browse..."
                                Click="BrowsePrivateKey_Click"
                                Background="#444" Foreground="#e0e0e0" Padding="12,8"
                                Margin="8,0,0,0"
                                CornerRadius="4" ToolTip.Tip="Browse for Private Key" />
                        </Grid>

                        <TextBlock Text="CONNECTION RETRY" Foreground="#6ea9d4" FontSize="10"
                            FontWeight="Bold" LetterSpacing="1.2" Margin="0,5,0,0" />
                        <Grid ColumnDefinitions="*, 15, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Retry Count" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding ConnectionRetryCount}" Background="#1e1e1e"
                                    Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555"
                                    Padding="8" CornerRadius="4" ToolTip.Tip="Connection attempts (min 1)" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Retry Delay (s)" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding ConnectionRetryDelaySeconds}" Background="#1e1e1e"
                                    Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555"
                                    Padding="8" CornerRadius="4" ToolTip.Tip="Seconds between attempts" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="IDLE SESSION" Foreground="#6ea9d4" FontSize="10"
                            FontWeight="Bold" LetterSpacing="1.2" Margin="0,5,0,0" />
                        <Grid ColumnDefinitions="*, 15, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Keep-Alive (s)" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding KeepAliveIntervalSeconds}" Background="#1e1e1e"
                                    Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555"
                                    Padding="8" CornerRadius="4"
                                    ToolTip.Tip="Send keep-alive every N seconds to prevent idle disconnects (0 to disable)" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Idle Timeout (min)" Foreground="#aaaaaa" FontSize="13" />
                                <TextBox Text="{Binding IdleTimeoutMinutes}" Background="#1e1e1e"
                                    Foreground="#e0e0e0" BorderThickness="1" BorderBrush="#555"
                                    Padding="8" CornerRadius="4"
                                    ToolTip.Tip="Auto-disconnect after N minutes without activity (0 keeps the session open indefinitely)" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="VERIFICATION" Foreground="#6ea9d4" FontSize="10"
                            FontWeight="Bold" LetterSpacing="1.2" Margin="0,5,0,0" />
                        <StackPanel Margin="0,5,0,0" Spacing="15">
                            <TextBlock Text="{Binding TestStatus}"
                                Foreground="{Binding TestStatusColor}" TextWrapping="Wrap"
                                HorizontalAlignment="Left" FontSize="13" FontWeight="Medium" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10">
                                <Button Content="Cancel"
                                    Command="{Binding HideConnectionModalCommand}"
                                    Background="#444" Foreground="#e0e0e0" Padding="15,8"
                                    CornerRadius="4" />
                                <Button Content="Test Connection" Classes="primaryButton"
                                    Command="{Binding TestConnectionCommand}" Background="#1769aa"
                                    Foreground="White" Padding="15,8" CornerRadius="4" />
                                <Button Content="Save Connection"
                                    Command="{Binding SaveConnectionCommand}"
                                    IsEnabled="{Binding IsTestSuccessful}" Background="#20a53a"
                                    Foreground="White" Padding="15,8" CornerRadius="4" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Border>

        <!-- Delete Confirmation Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsDeleteConfirmModalVisible}"
            ZIndex="101">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="350" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="Delete Connection?" FontWeight="Bold" FontSize="18"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to delete '" />
                        <Run Text="{Binding ProfileToDelete.Name}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                            Background="#444" Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                            Background="#f44336" Foreground="White" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Bookmark Delete Confirmation Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsBookmarkDeleteConfirmModalVisible}"
            ZIndex="111">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="380" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="Delete Bookmark?" FontWeight="Bold" FontSize="18"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to delete the bookmark for '" />
                        <Run Text="{Binding BookmarkToDelete.Path}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelRemoveBookmarkCommand}"
                            Background="#444" Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                        <Button Content="Delete" Command="{Binding ConfirmRemoveBookmarkCommand}"
                            Background="#f44336" Foreground="White" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Close Tab Confirmation Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsCloseConfirmModalVisible}" ZIndex="102">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="350" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="Close Tab?" FontWeight="Bold" FontSize="18"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to close '" />
                        <Run Text="{Binding TabToClose.Title}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCloseTabCommand}"
                            Background="#444" Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                        <Button Content="Close Session" Command="{Binding ConfirmCloseTabCommand}"
                            Background="#f44336" Foreground="White" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Rename File Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsRenameModalVisible}" ZIndex="103">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="400" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="Rename File" FontWeight="Bold" FontSize="18"
                        Foreground="#e0e0e0" />

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <TextBlock Text="New Name" Foreground="#aaaaaa" FontSize="13" />
                    <TextBox x:Name="RenameTextBox" Text="{Binding RenameModalText}"
                        Background="#1e1e1e" Foreground="#e0e0e0" BorderThickness="1"
                        BorderBrush="#555" Padding="8" CornerRadius="4"
                        PlaceholderText="Enter new filename" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Click="CancelRename_Click" Background="#444"
                            Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                        <Button Content="Rename" Click="ConfirmRename_Click" Background="#20a53a"
                            Foreground="White" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- File Properties Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsFilePropertiesModalVisible}"
            ZIndex="104">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="450" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="File Properties" FontWeight="Bold" FontSize="18"
                            Foreground="#e0e0e0" VerticalAlignment="Center" />
                        <Button Content="✕" Click="ClosePropertiesModal_Click"
                            Background="Transparent" Foreground="#888" HorizontalAlignment="Right"
                            FontSize="16" BorderThickness="0" />
                    </Grid>

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Name:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedFileProperties.Name}"
                                Foreground="#e0e0e0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Type:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.IsDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='File'}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Size:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.SizeDisplay}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Modified:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.ModifiedDisplay}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Permissions:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.Permissions}"
                                Foreground="#e0e0e0" FontFamily="Consolas, Fira Code, monospace"
                                FontSize="12" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Full Path:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.FullName}"
                                Foreground="#e0e0e0" TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding SelectedFileProperties.FullName}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,15,0,0">
                        <Button Content="Close" Click="ClosePropertiesModal_Click" Background="#444"
                            Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- File Preview Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsFilePreviewModalVisible}" ZIndex="105">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="700" Height="500" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="{Binding FilePreviewName}" FontWeight="Bold" FontSize="16"
                            Foreground="#e0e0e0" VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Button Content="✕" Click="ClosePreviewModal_Click" Background="Transparent"
                            Foreground="#888" HorizontalAlignment="Right" FontSize="16"
                            BorderThickness="0" />
                    </Grid>

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding FilePreviewContent}" Foreground="#ccc"
                            FontFamily="Consolas, Fira Code, monospace" FontSize="12" Padding="10"
                            TextWrapping="Wrap" Background="#1e1e1e" />
                    </ScrollViewer>

                    <Button Content="Close" Click="ClosePreviewModal_Click" Background="#444"
                        Foreground="#e0e0e0" Padding="15,8" CornerRadius="4"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Border>

        <!-- File Permissions Editor Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsPermissionsModalVisible}" ZIndex="106">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="500" Padding="25" BoxShadow="0 10 30 0 #55000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Edit File Permissions" FontWeight="Bold" FontSize="18"
                            Foreground="#e0e0e0" VerticalAlignment="Center" />
                        <Button Content="✕" Click="ClosePermissionsModal_Click"
                            Background="Transparent" Foreground="#888" HorizontalAlignment="Right"
                            FontSize="16" BorderThickness="0" />
                    </Grid>

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <TextBlock Text="File:" Foreground="#aaaaaa" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedFileForPermissions.Name}" Foreground="#e0e0e0"
                        FontSize="13" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="Current Permissions:" Foreground="#aaaaaa" FontSize="13"
                        FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelectedFileForPermissions.Permissions}"
                        Foreground="#e0e0e0" FontFamily="Consolas, Fira Code, monospace"
                        FontSize="14" />

                    <StackPanel Spacing="10" Margin="0,15,0,0">
                        <TextBlock Text="Set Permissions (Octal):" Foreground="#aaaaaa"
                            FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="PermissionsInput" Background="#1e1e1e" Foreground="#e0e0e0"
                            BorderThickness="1" BorderBrush="#555" Padding="8" CornerRadius="4"
                            PlaceholderText="e.g., 755, 644, 777" Text="755"
                            ToolTip.Tip="Enter 3-digit octal notation (0-7 for each digit)" />

                        <StackPanel Spacing="5">
                            <TextBlock Text="Common Presets:" Foreground="#aaaaaa" FontSize="11" />
                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="5">
                                <Button Grid.Column="0" Content="644" Click="SetPermissions_Click"
                                    Tag="644" Background="#333" Foreground="#e0e0e0" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="1" Content="755" Click="SetPermissions_Click"
                                    Tag="755" Background="#333" Foreground="#e0e0e0" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="2" Content="777" Click="SetPermissions_Click"
                                    Tag="777" Background="#333" Foreground="#e0e0e0" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="3" Content="600" Click="SetPermissions_Click"
                                    Tag="600" Background="#333" Foreground="#e0e0e0" Padding="8,6"
                                    CornerRadius="3" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,15,0,0">
                        <Button Content="Cancel" Click="ClosePermissionsModal_Click"
                            Background="#444" Foreground="#e0e0e0" Padding="15,8" CornerRadius="4" />
                        <Button Content="Apply" Click="ApplyPermissions_Click" Background="#20a53a"
                            Foreground="White" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- About Dialog Modal -->
        <Border Background="#99000000" IsVisible="{Binding IsAboutDialogVisible}" ZIndex="110">
            <Border Background="#2d2d30" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" MaxHeight="700" Padding="30" BoxShadow="0 10 30 0 #55000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TERMOX" FontWeight="Bold" FontSize="24"
                                Foreground="#e0e0e0" />
                                <TextBlock Text="SSH &amp; SFTP workspace" FontSize="14"
                                    Foreground="#aaa" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="✕" Click="CloseAboutDialog_Click"
                                Background="Transparent" Foreground="#888"
                                HorizontalAlignment="Right" FontSize="18" BorderThickness="0"
                                Padding="10" />
                        </Grid>

                        <Rectangle Height="1" Fill="#444" Margin="0,10,0,0" />

                        <!-- Product identity -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="The Termox project" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Text="TERMOX" FontSize="16"
                                FontWeight="Bold" Foreground="#e0e0e0" />
                            <TextBlock
                                Text="A focused, cross-platform workspace for secure SSH connections, terminal sessions, SFTP file management, and network utilities."
                                Foreground="#aaa" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Product details -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="Product" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Version " />
                                <Run Text="{Binding ApplicationVersion}" />
                                <Run Text="&#10;" />
                                <Run Text="Built for developers, operators, and anyone who works across remote systems." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Tech Stack -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="Technology Stack" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="11" TextWrapping="Wrap">
                                <Run
                                    Text="Built with Avalonia UI, SSH.NET, and .NET 10.0&#10;Cross-platform support: Windows, macOS, Linux" />
                            </TextBlock>
                        </StackPanel>

                        <!-- License -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="License" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="11" TextWrapping="Wrap">
                                <Run
                                    Text="MIT License - © 2026 The Termox Project&#10;See LICENSE file for full terms." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Close" Background="#444" Foreground="#e0e0e0"
                                Padding="15,8" CornerRadius="4" Click="CloseAboutDialog_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Panel>
</Window>
