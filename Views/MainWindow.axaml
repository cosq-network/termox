<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Termox.ViewModels"
    xmlns:models="using:Termox.Models"
    xmlns:services="using:Termox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:terminal="using:SvcSystems.UI.Terminal"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
    x:Class="Termox.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/Icons/termox-icon.png"
    Title="Termox — SSH &amp; SFTP Workspace"
    Width="1050" Height="700"
    Background="#2d2d30"
    KeyDown="MainWindow_KeyDown"
    FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="None"
    ExtendClientAreaTitleBarHeightHint="40">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Base Layout using DockPanel -->
        <DockPanel>

            <!-- Custom title bar: icon, menu, back/forward + current-tab pill (draggable
                 middle), then minimize/tab-switcher/close. Window uses
                 ExtendClientAreaToDecorationsHint + NoChrome so nothing native is drawn —
                 everything here (including window drag/minimize/close) is hand-rolled. -->
            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource TermoxPanelBrush}"
                ColumnDefinitions="Auto,Auto,*,Auto">
                <Image Grid.Column="0" Source="/Assets/Icons/termox-icon.png"
                    Width="18" Height="18" Margin="10,0,8,0" VerticalAlignment="Center" />

                <Menu Grid.Column="1" Background="Transparent"
                    Foreground="{StaticResource TermoxTextPrimaryBrush}" VerticalAlignment="Center">
                    <MenuItem>
                        <MenuItem.Header>
                            <primitives:AccessText Text="_Termox" Foreground="#f4f7fb" />
                        </MenuItem.Header>
                        <MenuItem Header="About Termox"
                            Command="{Binding ShowAboutDialogCommand}" />
                        <MenuItem Header="User Manual"
                            Command="{Binding ShowUserManualDialogCommand}" />
                        <Separator />
                        <MenuItem Header="Exit Termox" Click="ExitTermox_Click" />
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Header>
                            <primitives:AccessText Text="_Session" Foreground="#f4f7fb" />
                        </MenuItem.Header>
                        <MenuItem Header="New Connection"
                            Command="{Binding ShowConnectionModalCommand}" />
                        <MenuItem Header="Disconnect Current Tab"
                            Command="{Binding DisconnectCommand}" />
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Header>
                            <primitives:AccessText Text="_Help" Foreground="#f4f7fb" />
                        </MenuItem.Header>
                        <MenuItem Header="User Manual"
                            Command="{Binding ShowUserManualDialogCommand}" />
                        <MenuItem Header="About Termox"
                            Command="{Binding ShowAboutDialogCommand}" />
                    </MenuItem>
                </Menu>

                <!-- Draggable middle region: empty space here moves the window; the
                     back/forward/pill cluster sits left-aligned within it. -->
                <Border Grid.Column="2" Background="Transparent"
                    PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                        <Button Classes="toolButton" Margin="0" Padding="6,5"
                            Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBackTabs}"
                            ToolTip.Tip="Back">
                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE5CB;" FontSize="15" />
                        </Button>
                        <Button Classes="toolButton" Margin="0" Padding="6,5"
                            Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForwardTabs}"
                            ToolTip.Tip="Forward">
                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE5CC;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
                    <Button Classes="windowControlBtn" VerticalAlignment="Stretch"
                        Click="Minimize_Click" ToolTip.Tip="Minimize">
                        <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE931;" FontSize="13" />
                    </Button>
                    <Button Classes="windowControlBtn" VerticalAlignment="Stretch"
                        Click="MaximizeRestore_Click" ToolTip.Tip="Maximize / Restore">
                        <TextBlock Name="MaximizeIcon" FontFamily="{StaticResource MaterialIconFont}" Text="&#xE5D0;" FontSize="12" />
                    </Button>
                    <Button Classes="windowControlBtn closeTabBtn" VerticalAlignment="Stretch"
                        Click="ExitTermox_Click" ToolTip.Tip="Close">
                        <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE5CD;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition
                        Width="{Binding IsSidebarPanelVisible, Converter={x:Static services:BoolToGridLengthConverter.Instance}, ConverterParameter=280}" />
                    <ColumnDefinition
                        Width="{Binding IsSidebarPanelVisible, Converter={x:Static services:BoolToGridLengthConverter.Instance}, ConverterParameter=5}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Icon-first nav rail (Sessions/Bookmarks/Tools/Chat) -->
                <Border Grid.Column="0" Background="{StaticResource TermoxPanelBrush}">
                    <StackPanel>
                        <Button Classes="sidebarRailButton" Classes.active="{Binding IsSessionsSectionActive}"
                            Command="{Binding SelectSidebarSectionCommand}" CommandParameter="Sessions"
                            ToolTip.Tip="Sessions">
                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE30A;" FontSize="24" />
                        </Button>
                        <Button Classes="sidebarRailButton" Classes.active="{Binding IsBookmarksSectionActive}"
                            Command="{Binding SelectSidebarSectionCommand}" CommandParameter="Bookmarks"
                            ToolTip.Tip="Bookmarks">
                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE867;" FontSize="24" />
                        </Button>
                        <Button Classes="sidebarRailButton" Classes.active="{Binding IsToolsSectionActive}"
                            Command="{Binding SelectSidebarSectionCommand}" CommandParameter="Tools"
                            ToolTip.Tip="Tools">
                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE869;" FontSize="24" />
                        </Button>
                        <Button Classes="sidebarRailButton" Classes.active="{Binding IsChatSectionActive}"
                            Command="{Binding SelectSidebarSectionCommand}" CommandParameter="Chat"
                            ToolTip.Tip="Helm (AI Assistant)">
                            <TextBlock Text="⎈" FontSize="24" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sidebar panel (Sessions/Tools) — column width is driven by IsSidebarPanelVisible
                     via BoolToGridLengthConverter (same pattern as the split-view columns below),
                     so clicking the active rail icon again collapses it to 0 instead of leaving a gap. -->
                <Border Grid.Column="1" IsVisible="{Binding IsSidebarPanelVisible}"
                    Background="{StaticResource TermoxSurfaceBrush}"
                    BorderBrush="{StaticResource TermoxPanelBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.Styles>
                            <!-- FluentTheme's own ListBoxItem template setting CornerRadius on its
                                 internal PART_ContentPresenter Border wasn't overridable from here
                                 (its compiled template resource can't be inspected/fought reliably),
                                 so this owns the whole template instead — guarantees the radius. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="{StaticResource TermoxSurfaceHoverBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{StaticResource TermoxSelectionBrush}" />
                            </Style>
                        </Grid.Styles>

                        <ScrollViewer IsVisible="{Binding IsSessionsSectionActive}">
                                <StackPanel Margin="15" Spacing="10">
                                    <TextBlock Text="SESSIONS" FontSize="10" FontWeight="Bold"
                                        Foreground="#6ea9d4" LetterSpacing="1.2" />
                                    <Button Command="{Binding ShowConnectionModalCommand}"
                                        Classes="primaryButton" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" FontSize="12.5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE145;" FontSize="14" />
                                            <TextBlock Text="New Connection" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="Recently Used" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888" Margin="0,10,0,0"
                                        IsVisible="{Binding HasRecentlyUsedSessions}" />

                                    <Border Classes="cardPanel" IsVisible="{Binding HasRecentlyUsedSessions}">
                                    <ListBox ItemsSource="{Binding RecentlyUsedSessions}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *" Margin="0,4"
                                                    Background="Transparent"
                                                    ToolTip.Tip="{Binding Host}"
                                                    DoubleTapped="SavedSession_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectSftpProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <PathIcon Grid.Column="0"
                                                        Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                                        Width="14" Height="14" Foreground="#6ee7a8"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                            Foreground="#e0e0e0" FontSize="13"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Host}"
                                                            Foreground="#888888" FontSize="11"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Border>

                                    <TextBlock Text="Saved Sessions" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888" Margin="0,10,0,0"
                                        IsVisible="{Binding HasSavedConnections}" />

                                    <Border Classes="cardPanel" IsVisible="{Binding HasSavedConnections}">
                                    <ListBox ItemsSource="{Binding SavedConnections}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *" Margin="0,4"
                                                    Background="Transparent"
                                                    ToolTip.Tip="{Binding Host}"
                                                    DoubleTapped="SavedSession_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectSftpProfileCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteProfileCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <PathIcon Grid.Column="0"
                                                        Data="M4 4h16v12H5.17L4 17.17V4m0-2c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4zm10 10H6v-2h8v2z"
                                                        Width="16" Height="16" Foreground="#007acc"
                                                        Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                            Foreground="#e0e0e0" FontSize="13"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Host}"
                                                            Foreground="#888888" FontSize="11"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Border>
                                    <StackPanel IsVisible="{Binding !HasSavedConnections}" Spacing="4"
                                        Margin="4,12,4,0">
                                        <TextBlock Text="No saved sessions yet" Foreground="#c9d1db"
                                            FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="Create a connection to get started."
                                            Foreground="#858d98" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        <ScrollViewer IsVisible="{Binding IsBookmarksSectionActive}">
                                <StackPanel Margin="15" Spacing="10">
                                    <TextBlock Text="BOOKMARKS" FontSize="10" FontWeight="Bold"
                                        Foreground="#6ea9d4" LetterSpacing="1.2" />

                                    <!-- Pinned / favorite bookmarks -->
                                    <TextBlock Text="⭐ Favorites" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888"
                                        IsVisible="{Binding HasFavoritedBookmarks}" />
                                    <Border Classes="cardPanel" IsVisible="{Binding HasFavoritedBookmarks}">
                                    <ListBox ItemsSource="{Binding FavoritedBookmarks}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,4"
                                                    Background="Transparent" ToolTip.Tip="{Binding Path}"
                                                    DoubleTapped="Bookmark_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu Background="#2d2d30" Foreground="#e0e0e0">
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkTerminalCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkSftpCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Remove Favorite"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleBookmarkFavoriteCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveBookmarkCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Button Grid.Column="0" Content="{Binding FavoriteGlyph}"
                                                        Click="ToggleBookmarkFavorite_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{Binding FavoriteColor}"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FavoriteToolTip}" />
                                                    <PathIcon Grid.Column="1"
                                                        Data="M17 3H5c-1.11 0-2 .9-2 2v16l7-3 7 3V5c0-1.1.89-2 2-2z"
                                                        Width="14" Height="14" Foreground="#f39c12"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SessionName}"
                                                            Foreground="#888888" FontSize="10"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="✕"
                                                        Click="RemoveBookmark_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#888"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Border>

                                    <TextBlock Text="Saved Bookmarks" FontWeight="SemiBold"
                                        FontSize="13" Foreground="#888"
                                        IsVisible="{Binding HasBookmarks}" />
                                    <Border Classes="cardPanel" IsVisible="{Binding HasBookmarks}">
                                    <ListBox ItemsSource="{Binding Bookmarks}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,4"
                                                    Background="Transparent" ToolTip.Tip="{Binding Path}"
                                                    DoubleTapped="Bookmark_DoubleTapped">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu Background="#2d2d30" Foreground="#e0e0e0">
                                                            <MenuItem Header="Open SSH Terminal"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkTerminalCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open SFTP Browser"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBookmarkSftpCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Add to Favorites"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleBookmarkFavoriteCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Delete"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveBookmarkCommand}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#f44336" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Button Grid.Column="0" Content="{Binding FavoriteGlyph}"
                                                        Click="ToggleBookmarkFavorite_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{Binding FavoriteColor}"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FavoriteToolTip}" />
                                                    <PathIcon Grid.Column="1"
                                                        Data="M17 3H5c-1.11 0-2 .9-2 2v16l7-3 7 3V5c0-1.1.89-2 2-2z"
                                                        Width="14" Height="14" Foreground="#f39c12"
                                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SessionName}"
                                                            Foreground="#888888" FontSize="10"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="✕"
                                                        Click="RemoveBookmark_Click"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#888"
                                                        BorderThickness="0" Padding="2"
                                                        FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Border>
                                    <StackPanel IsVisible="{Binding !HasBookmarks}" Spacing="4"
                                        Margin="4,12,4,0">
                                        <TextBlock Text="No bookmarks yet" Foreground="#c9d1db"
                                            FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="Bookmark a remote folder from SFTP."
                                            Foreground="#858d98" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding IsToolsSectionActive}">
                                <StackPanel Margin="15" Spacing="10">
                                    <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold"
                                        Foreground="#6ea9d4" LetterSpacing="1.2" />
                                    <StackPanel Spacing="4">
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenPortScannerTabCommand}"
                                        ToolTip.Tip="Open the dedicated port scanner tab">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE640;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Port Scanner" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Check open TCP ports on a host" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenPingTestTabCommand}"
                                        ToolTip.Tip="Open the dedicated ping test tab">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE915;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Ping Test" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Measure reachability and latency" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenSshKeyGeneratorTabCommand}"
                                        ToolTip.Tip="Open the dedicated SSH key generator tab">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE0DA;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="SSH Key Generator" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Create new OpenSSH key pairs" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenConnectionTesterTabCommand}"
                                        ToolTip.Tip="Test all saved connections">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE157;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Connection Tester" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Batch-test all saved connections" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenSshEndpointTestTabCommand}"
                                        ToolTip.Tip="Test SSH endpoint performance">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE9E4;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="SSH Endpoint Test" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Check SSH endpoint reachability" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenGpgTabCommand}"
                                        ToolTip.Tip="Manage GPG keys and export/import">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE897;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="GPG Key Manager" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Manage, import, and export GPG keys" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenFingerprintTabCommand}"
                                        ToolTip.Tip="Calculate and compare file/text fingerprints">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE90D;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Fingerprint Utilities" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Hash and compare file/text fingerprints" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenDnsTabCommand}"
                                        ToolTip.Tip="Inspect DNS records for domains">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE875;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="DNS Inspector" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Query DNS records for any domain" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="toolListItem"
                                        Command="{Binding OpenServerStatsTabCommand}"
                                        ToolTip.Tip="View CPU, memory, process, and disk stats over SSH">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#1c2733" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE26B;" FontSize="15"
                                                    Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Server Stats" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="CPU, memory, and disk stats over SSH" FontSize="10.5"
                                                    Foreground="#8a8f98" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding IsChatSectionActive}">
                                <StackPanel Margin="15" Spacing="10">
                                    <TextBlock Text="HELM" FontSize="10" FontWeight="Bold"
                                        Foreground="#6ea9d4" LetterSpacing="1.2" />
                                    <Border Classes="cardPanel">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Helm can inspect and operate on your saved connections for you."
                                                Foreground="#aaaaaa" FontSize="12" TextWrapping="Wrap" />
                                            <Button Content="Open Chat" Classes="toolButton"
                                                Command="{Binding OpenChatTabCommand}"
                                                ToolTip.Tip="Open the chat assistant tab" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="2" Background="#333" Width="5"
                    IsVisible="{Binding IsSidebarPanelVisible}"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Terminal Area with Tab -->
                <Grid Grid.Column="3" Background="#1e1e1e">
                    <!-- Shared with the split-view pane below: Control.DataTemplates resolves up the
                         visual tree, so hoisting it here (instead of on the primary TabControl) lets
                         both the main tab strip and the split pane's plain ContentControl render any
                         tab type from the same template set, with zero duplication. -->
                    <Grid.DataTemplates>
                            <DataTemplate DataType="vm:TerminalTabViewModel">
                                <Border Background="#0c0c0c" Padding="5">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,5">
                                            <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                                            <Button Grid.Column="1" Content="Reconnect"
                                                Command="{Binding ReconnectCommand}"
                                                IsVisible="{Binding IsReconnectAvailable}"
                                                Classes="neutralButton"
                                                Padding="12,5" CornerRadius="3" />
                                        </Grid>
                                        <terminal:TerminalControl Grid.Row="1" Model="{Binding TerminalModel}"
                                            FontFamily="Consolas, Fira Code, Cascadia Code, Courier New, monospace"
                                            FontSize="15"
                                            RightClickAction="CopyOrPaste"
                                            KeyDown="Terminal_KeyDown">
                                        <terminal:TerminalControl.ContextMenu>
                                            <ContextMenu Background="#2d2d30" Foreground="#e0e0e0"
                                                Opened="TerminalContextMenu_Opened">
                                                <MenuItem x:Name="TerminalCopyMenuItem" Header="Copy"
                                                    IsEnabled="False" Click="CopyMenu_Click">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"
                                                            Width="14" Height="14"
                                                            Foreground="#e0e0e0" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="TerminalPasteMenuItem" Header="Paste"
                                                    IsEnabled="False" Click="PasteMenu_Click" />
                                                <MenuItem Header="Duplicate SSH Terminal"
                                                    InputGesture="Ctrl+Shift+D"
                                                    Click="DuplicateTerminalMenu_Click" />
                                                <Separator />
                                                <MenuItem Header="Open SFTP"
                                                    Click="OpenSftpFromTerminal_Click" />
                                                <MenuItem Header="Add to Bookmarks"
                                                    Click="AddTerminalDirectoryBookmark_Click" />
                                            </ContextMenu>
                                        </terminal:TerminalControl.ContextMenu>
                                        </terminal:TerminalControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SftpTabViewModel">
                                <Border Background="#1e1e1e" Padding="10">
                                    <Panel>
                                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto"
                                            Margin="0,0,0,10">
                                            <Button Grid.Column="0" Content="↑"
                                                Command="{Binding NavigateUpCommand}"
                                                Margin="0,0,5,0" Classes="neutralButton"
                                                ToolTip.Tip="Navigate to parent directory" />
                                            <TextBox Grid.Column="1" Text="{Binding CurrentPath}"
                                                IsReadOnly="False" VerticalContentAlignment="Center"
                                                KeyDown="SftpPathBox_KeyDown" />
                                            <Button Grid.Column="2" Content="⭐"
                                                Click="AddBookmark_Click" Margin="5,0,0,0"
                                                Classes="warningButton"
                                                ToolTip.Tip="Add current path as bookmark" />
                                            <Button Grid.Column="3" Content="Refresh"
                                                Command="{Binding RefreshCommand}" Margin="5,0,0,0"
                                                Classes="neutralButton"
                                                ToolTip.Tip="Reload directory contents" />
                                        </Grid>

                                        <!-- File actions stay directly below the address bar. -->
                                        <Grid Grid.Row="1"
                                            ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                                            Margin="0,0,0,10">
                                            <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                Foreground="{Binding StatusColor}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Status}" Margin="0,0,10,0" />
                                            <Button Grid.Column="1"
                                                Click="UploadFile_Click" Classes="neutralButton" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Upload local files"
                                                Margin="0,0,3,0"
                                                IsVisible="{Binding !IsTransferring}" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE2C6;" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                Click="DownloadFile_Click"
                                                CommandParameter="{Binding #SftpListBox.SelectedItems}"
                                                Classes="neutralButton"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Download selected"
                                                IsEnabled="{Binding CanDownload}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE2C4;" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                Command="{Binding DeleteFileCommand}"
                                                Classes="neutralButton"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Delete selected file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE872;" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                Click="RenameFile_Click" Classes="neutralButton" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Rename file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE3C9;" />
                                            </Button>
                                            <Button Grid.Column="5"
                                                Click="EditFile_Click" Classes="neutralButton" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Edit selected file"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE70F;" />
                                            </Button>
                                            <Button Grid.Column="6"
                                                Click="EditPermissions_Click" Classes="neutralButton" Padding="12,6" CornerRadius="4"
                                                Cursor="Hand" ToolTip.Tip="Edit file permissions"
                                                IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE897;" />
                                            </Button>
                                            <Button Grid.Column="7"
                                                Command="{Binding BulkDeleteCommand}"
                                                Classes="neutralButton"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                ToolTip.Tip="Delete all selected files"
                                                IsEnabled="{Binding CanBulkDelete}"
                                                IsVisible="{Binding !IsTransferring}"
                                                Margin="0,0,3,0" FontSize="12">
                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE92E;" />
                                            </Button>
                                            <Button Grid.Column="8"
                                                Content="{Binding PauseButtonText}"
                                                Command="{Binding TogglePauseCommand}"
                                                Classes="warningButton"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                Margin="0,0,3,0"
                                                IsVisible="{Binding IsTransferring}" FontSize="12" />
                                            <Button Grid.Column="9" Content="Cancel Transfer"
                                                Command="{Binding CancelTransferCommand}"
                                                Classes="dangerButton"
                                                Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                IsVisible="{Binding IsTransferring}" FontSize="12" />
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto"
                                            Margin="0,0,0,10">
                                            <TextBox Grid.Column="0" Text="{Binding SearchQuery}"
                                                PlaceholderText="🔍 Search files..."
                                                ToolTip.Tip="Filter files by name" />
                                        </Grid>

                                        <ListBox x:Name="SftpListBox" Grid.Row="3"
                                            ItemsSource="{Binding Files}"
                                            SelectedItem="{Binding SelectedFile}"
                                            SelectionMode="Multiple"
                                            SelectionChanged="SftpFileList_SelectionChanged"
                                            Background="#252526" BorderThickness="1"
                                            BorderBrush="#333"
                                            DoubleTapped="SftpFileList_DoubleTapped"
                                            KeyDown="SftpFileList_KeyDown">
                                            <ListBox.ContextMenu>
                                                <ContextMenu Background="#2d2d30"
                                                    Foreground="#e0e0e0">
                                                    <MenuItem Header="Download"
                                                        Click="ContextMenu_Download"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Upload"
                                                        Click="ContextMenu_Upload" />
                                                    <Separator />
                                                    <MenuItem Header="Rename"
                                                        Click="ContextMenu_Rename"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Delete"
                                                        Click="ContextMenu_Delete"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <Separator />
                                                    <MenuItem Header="Edit"
                                                        Click="ContextMenu_Edit"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Preview"
                                                        Click="ContextMenu_Preview"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Header="Properties"
                                                        Click="ContextMenu_Properties"
                                                        IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <Separator />
                                                    <MenuItem Header="Add to Bookmarks"
                                                        Click="ContextMenu_AddBookmark" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="35, *, 90, 140, 110"
                                                        Margin="0,4">
                                                        <TextBlock Grid.Column="0"
                                                            Text="{Binding IconDisplay}"
                                                            FontSize="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                            Text="{Binding Name}"
                                                            Foreground="#e0e0e0"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                            Text="{Binding SizeDisplay}"
                                                            Foreground="#888" TextAlignment="Right"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                            Text="{Binding ModifiedDisplay}"
                                                            Foreground="#888"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4"
                                                            Text="{Binding Permissions}"
                                                            Foreground="#666"
                                                            FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                            FontSize="12" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </Grid>
                                    <!-- Local ZIndex 20/21 — only needs to beat siblings within this SFTP tab's Panel, not the global 100s modal band -->
                                    <Border Classes="modalScrim" IsVisible="{Binding IsDeleteConfirmationVisible}"
                                        ZIndex="20">
                                        <Border Classes="modalCard" Width="420" Padding="22">
                                            <StackPanel Spacing="14">
                                                <TextBlock Text="Confirm Remote Delete" FontSize="{StaticResource TermoxTitleFontSize}"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap"
                                                    Foreground="#ccc" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                                                        Classes="neutralButton" />
                                                    <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                                                        Classes="dangerButton" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <Border Classes="modalScrim" IsVisible="{Binding IsFileSizeWarningVisible}"
                                        ZIndex="21">
                                        <Border Classes="modalCard" Width="440" Padding="22">
                                            <StackPanel Spacing="14">
                                                <TextBlock Text="Large Download Warning" FontSize="{StaticResource TermoxTitleFontSize}"
                                                    FontWeight="SemiBold" Foreground="#f39c12" />
                                                <TextBlock Text="{Binding FileSizeWarningMessage}" TextWrapping="Wrap"
                                                    Foreground="#ccc" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                    <Button Content="Cancel" Command="{Binding CancelFileSizeWarningCommand}"
                                                        Classes="neutralButton" />
                                                    <Button Content="Download Anyway" Command="{Binding ConfirmFileSizeWarningCommand}"
                                                        Classes="warningButton" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FileEditorTabViewModel">
                                <Border Background="#1e1e1e" Padding="10">
                                    <Panel>
                                        <Grid RowDefinitions="Auto, *">
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto"
                                                Margin="0,0,0,10">
                                                <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                    Foreground="{Binding StatusColor}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Status}" Margin="0,0,10,0" />
                                                <Button Grid.Column="1" Content="{Binding SaveButtonText}"
                                                    Command="{Binding SaveCommand}"
                                                    IsEnabled="{Binding IsDirty}"
                                                    Classes="neutralButton"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Save changes to remote file"
                                                    Margin="0,0,3,0" FontSize="12" />
                                                <Button Grid.Column="2" Content="Save &amp; Close"
                                                    Command="{Binding SaveAndCloseCommand}"
                                                    Classes="successButton"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Save changes and close this editor tab"
                                                    Margin="0,0,3,0" FontSize="12" />
                                                <Button Grid.Column="3" Content="✕"
                                                    Command="{Binding CloseTabCommand}"
                                                    Classes="dangerButton"
                                                    Padding="12,6" CornerRadius="4" Cursor="Hand"
                                                    ToolTip.Tip="Close editor (prompts if unsaved changes)"
                                                    FontSize="12" />
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <edit:TextEditor x:Name="Editor"
                                                    Document="{Binding Document}"
                                                    FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                    FontSize="14"
                                                    ShowLineNumbers="True"
                                                    Background="#1e1e1e"
                                                    Foreground="#e0e0e0"
                                                    IsVisible="{Binding !IsLoading}" />
                                                <TextBlock Text="Loading remote file..."
                                                    Foreground="#888" FontSize="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLoading}" />
                                            </Grid>
                                        </Grid>
                                        <!-- Local ZIndex 30 — only needs to beat siblings within this FileEditor tab's Panel -->
                                        <Border Classes="modalScrim" IsVisible="{Binding IsSaveConfirmVisible}"
                                            ZIndex="30">
                                            <Border Classes="modalCard" Width="420" Padding="22">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Unsaved Changes" FontSize="{StaticResource TermoxTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="#f39c12" />
                                                    <TextBlock Text="This file has unsaved changes. Close without saving?"
                                                        TextWrapping="Wrap" Foreground="#ccc" />
                                                    <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Spacing="10">
                                                        <Button Content="Cancel"
                                                            Command="{Binding CancelDiscardCommand}"
                                                            Classes="neutralButton" />
                                                        <Button Content="Discard Changes"
                                                            Command="{Binding ConfirmDiscardCommand}"
                                                            Classes="dangerButton" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PortScannerTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE640;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Port Scanner" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Inspect TCP reachability across a host with clear, focused results."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                                                    <StackPanel Grid.Row="0" Spacing="3">
                                                        <TextBlock Text="Scan configuration" Foreground="#e5e5e5"
                                                            FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="Choose a saved session or localhost, then specify the TCP ports to inspect."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Spacing="5">
                                                        <TextBlock Text="Target host" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <ComboBox ItemsSource="{Binding HostOptions}"
                                                            SelectedItem="{Binding SelectedHost}"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" Padding="10" MinHeight="44"
                                                            HorizontalContentAlignment="Stretch" CornerRadius="4">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="3" Margin="2,3">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                            Foreground="#e5e5e5" FontSize="13" />
                                                                        <TextBlock Text="{Binding Host}"
                                                                            Foreground="#888" FontSize="11" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                                        <StackPanel Grid.Column="0" Spacing="5">
                                                            <TextBlock Text="Ports to scan" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding ScanPorts}" PlaceholderText="22, 80, 443"
                                                                Padding="10" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Start Scan"
                                                            Command="{Binding ScanPortsCommand}"
                                                            Classes="primaryButton"
                                                            Padding="22,9" CornerRadius="4" FontSize="12"
                                                            VerticalAlignment="Bottom" IsEnabled="{Binding !IsScanning}" />
                                                    </Grid>

                                                    <Border Grid.Row="3" Background="#1e1e1e" CornerRadius="4"
                                                        Padding="12,9" BorderBrush="#333" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <TextBlock Text="STATUS" Foreground="#777" FontSize="10"
                                                                FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ScanStatus}"
                                                                Foreground="#8fbed0" FontSize="12" Margin="12,0,0,0"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="Scan results" Foreground="#e5e5e5"
                                                                FontSize="15" FontWeight="SemiBold" />
                                                            <TextBlock Text="Open ports are highlighted in green."
                                                                Foreground="#888" FontSize="11" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ScanResults.Count, StringFormat='{}{0} results'}"
                                                            Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Padding="12,8" Background="#1e1e1e">
                                                        <Grid ColumnDefinitions="100,*,100"
                                                            Background="#1e1e1e">
                                                            <TextBlock Text="PORT" Foreground="#777" FontSize="10"
                                                                FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="PROTOCOL" Foreground="#777"
                                                                FontSize="10" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2" Text="STATUS" Foreground="#777"
                                                                FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                    <ListBox Grid.Row="2" ItemsSource="{Binding ScanResults}"
                                                        Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                                                        MinHeight="260">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="12,9" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="100,*,100">
                                                                        <TextBlock Text="{Binding Port}" Foreground="#ddd"
                                                                            FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="1" Text="TCP"
                                                                            Foreground="#888" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                                            Foreground="{Binding StatusColor}"
                                                                            FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PingTestTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="760">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE915;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Ping Test" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Measure network reachability and round-trip response time for a host."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                                                        <TextBlock Text="Target host" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding PingHost}" PlaceholderText="example.com or 192.168.1.1"
                                                            Padding="10" MinHeight="42" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                                        <TextBlock Text="Requests" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding PingCount}" Minimum="1" Maximum="10"
                                                            MinHeight="42" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="1" Content="Start Ping"
                                                        Command="{Binding PingCommand}" Classes="primaryButton" Padding="22,9" CornerRadius="4"
                                                        VerticalAlignment="Bottom" IsEnabled="{Binding !IsPinging}" />
                                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="#1e1e1e" CornerRadius="4" Padding="12,9">
                                                        <TextBlock Text="Results appear below as replies arrive."
                                                            Foreground="#8fbed0" FontSize="12" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ListBox ItemsSource="{Binding PingResults}" Background="#1a1a1a"
                                                BorderThickness="1" BorderBrush="#333" MinHeight="180">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="80,*,Auto" Margin="12,8">
                                                            <TextBlock Text="{Binding Sequence, StringFormat='SEQ {0}'}"
                                                                Foreground="#ccc" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="TCP/IP echo response"
                                                                Foreground="#888" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Response}"
                                                                Foreground="{Binding ResponseColor}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SshKeyGeneratorTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="860">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE0DA;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="SSH Key Generator" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Create an OpenSSH key pair for secure remote access."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                                        <TextBlock Text="Key type" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <ComboBox ItemsSource="{Binding KeyTypes}"
                                                            SelectedItem="{Binding SelectedKeyType}"
                                                            Background="#1e1e1e" Foreground="#e5e5e5"
                                                            BorderBrush="#555" Padding="10" MinHeight="42" CornerRadius="4" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Width="190" Spacing="5"
                                                        IsVisible="{Binding IsRsaKeySelected}">
                                                        <TextBlock Text="RSA key size" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding KeySize}" Minimum="1024" Maximum="4096"
                                                            MinHeight="42" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="0" Content="Generate Key"
                                                        Command="{Binding GenerateKeyCommand}" Classes="primaryButton" Padding="22,9" CornerRadius="4"
                                                        HorizontalAlignment="Left" IsEnabled="{Binding !IsGeneratingKey}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Uses the system ssh-keygen command"
                                                        Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="#1e1e1e" CornerRadius="4" Padding="12,9">
                                                        <TextBlock Text="Private keys are generated locally and are never uploaded."
                                                            Foreground="#8fbed0" FontSize="12" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <TextBlock Text="Public key" Foreground="#aaa"
                                                        FontSize="11" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding GeneratedPublicKey}" Background="#1a1a1a"
                                                        Foreground="#e0e0e0" BorderBrush="#333" Padding="10"
                                                        Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="{StaticResource TermoxMonoFontFamily}" FontSize="12" />
                                                    <Button Content="Copy Public Key" Command="{Binding CopyPublicKeyCommand}"
                                                        Classes="neutralButton" Padding="10,6"
                                                        CornerRadius="4" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="Private key" Foreground="#aaa"
                                                        FontSize="11" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding GeneratedPrivateKey}" Background="#1a1a1a"
                                                        Foreground="#e0e0e0" BorderBrush="#333" Padding="10"
                                                        Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="{StaticResource TermoxMonoFontFamily}" FontSize="12" />
                                                    <Button Content="Copy Private Key" Command="{Binding CopyPrivateKeyCommand}"
                                                        Classes="neutralButton" Padding="10,6"
                                                        CornerRadius="4" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ConnectionTesterTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE157;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Connection Tester" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Verify connectivity for every saved SSH connection from one focused view."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Saved connection health" Foreground="#e5e5e5"
                                                            FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="Test host reachability and response time for your configured profiles."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Test All Connections"
                                                        Command="{Binding TestAllConnectionsCommand}"
                                                        Classes="primaryButton"
                                                        Padding="18,9" CornerRadius="4"
                                                        VerticalAlignment="Center" IsEnabled="{Binding !IsTesting}" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#1a1a1a" BorderBrush="#333"
                                                BorderThickness="1" CornerRadius="4" Padding="12,8">
                                                <Grid ColumnDefinitions="*,100,120">
                                                    <TextBlock Text="CONNECTION" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="STATUS" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="RESPONSE" Foreground="#777"
                                                        FontSize="10" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                            <ListBox ItemsSource="{Binding TestResults}" Background="#1a1a1a"
                                                BorderThickness="1" BorderBrush="#333" MinHeight="240">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10" BorderBrush="#2d2d2d"
                                                            BorderThickness="0,0,0,1">
                                                            <Grid ColumnDefinitions="*,100,120">
                                                                <TextBlock Text="{Binding ProfileName}" Foreground="#e0e0e0"
                                                                    FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                                    Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ResponseTime}"
                                                                    Foreground="#888" FontSize="11" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:SshEndpointTestTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="860">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE9E4;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="SSH Endpoint Test" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Measure the responsiveness of an SSH endpoint over an authenticated SFTP session."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="20">
                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                                    RowSpacing="14" ColumnSpacing="20">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                                                        <TextBlock Text="Target host" Foreground="#aaa"
                                                            FontSize="11" FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding SpeedTestHost}" PlaceholderText="hostname or IP address, e.g. 127.0.0.1:2222"
                                                            Padding="10" MinHeight="42" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                        Text="The endpoint test reports connection latency and SFTP benchmarking requirements."
                                                        Foreground="#8fbed0" FontSize="12" VerticalAlignment="Center" />
                                                    <Button Grid.Row="1" Grid.Column="1" Content="Test SSH Endpoint"
                                                        Command="{Binding RunSpeedTestCommand}" Classes="primaryButton" Padding="18,9" CornerRadius="4"
                                                        IsEnabled="{Binding !IsSpeedTesting}" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#1a1a1a" BorderBrush="#333"
                                                BorderThickness="1" CornerRadius="4" Padding="16" MinHeight="180">
                                                <TextBlock Text="{Binding SpeedTestResult}" Foreground="#ccc"
                                                    TextWrapping="Wrap" FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                    FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:GpgTabViewModel">
                                <!-- Panel root so the Import/Export modals below float over the whole
                                     tab (ZIndex-ordered siblings) instead of being laid out in-flow
                                     inside the scrollable StackPanel, which pushed them to the bottom
                                     of the page as an in-line black band rather than a floating overlay. -->
                                <Panel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE897;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="GPG Key Manager" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Manage your GPG keys, view details, export, and import keys."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                        <Button Grid.Column="0" Content="Refresh Keys"
                                                            Command="{Binding RefreshKeysCommand}"
                                                            Classes="primaryButton"
                                                            Padding="14,8" CornerRadius="4"
                                                            IsEnabled="{Binding !IsLoading}" />
                                                        <Button Grid.Column="1" Content="Import Key"
                                                            Command="{Binding ShowImportModalCommand}"
                                                            Classes="successButton"
                                                            Padding="14,8" CornerRadius="4"
                                                            IsEnabled="{Binding !IsLoading}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                            Foreground="{Binding StatusColor}"
                                                            VerticalAlignment="Center"
                                                            TextWrapping="Wrap"
                                                            Margin="20,0,0,0" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Public Keys" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding PublicKeys}"
                                                    SelectedItem="{Binding SelectedPublicKey}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8"
                                                    MinHeight="120">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3">
                                                                <Grid RowDefinitions="Auto,Auto,Auto">
                                                                    <TextBlock Grid.Row="0"
                                                                        Text="{Binding UserId}" Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                        Text="{Binding KeyId, StringFormat='Key ID: {0}'}"
                                                                        Foreground="#999" FontSize="11"
                                                                        Margin="0,4,0,0" />
                                                                    <TextBlock Grid.Row="2"
                                                                        Text="{Binding CreatedDate, StringFormat='Created: {0}'}"
                                                                        Foreground="#666" FontSize="11"
                                                                        Margin="0,2,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Export Public Key"
                                                        Command="{Binding ExportPublicKeyCommand}"
                                                        Classes="infoButton"
                                                        Padding="12,6" CornerRadius="4"
                                                        IsEnabled="{Binding CanExportKey}" />
                                                    <Button Content="Delete Key"
                                                        Command="{Binding DeleteKeyCommand}"
                                                        Classes="dangerButton"
                                                        Padding="12,6" CornerRadius="4"
                                                        IsEnabled="{Binding CanDeleteKey}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Secret Keys" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding SecretKeys}"
                                                    SelectedItem="{Binding SelectedSecretKey}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8"
                                                    MinHeight="100">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3">
                                                                <Grid RowDefinitions="Auto,Auto">
                                                                    <TextBlock Grid.Row="0"
                                                                        Text="{Binding UserId}" Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                        Text="{Binding KeyId, StringFormat='Key ID: {0}'}"
                                                                        Foreground="#999" FontSize="11"
                                                                        Margin="0,4,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Content="Export Secret Key"
                                                    Command="{Binding ExportSecretKeyCommand}"
                                                    Classes="warningButton"
                                                    Padding="12,6" CornerRadius="4"
                                                    IsEnabled="{Binding CanExportSecretKey}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>

                                <!-- Import Modal -->
                                <Border Classes="modalScrim" IsVisible="{Binding IsImportModalVisible}"
                                    ZIndex="112">
                                    <Border Classes="modalCard" Width="600" Padding="22">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Import GPG Key" FontSize="{StaticResource TermoxTitleFontSize}"
                                                FontWeight="SemiBold" Foreground="#e0e0e0" />
                                            <TextBlock Text="Paste the ASCII-armored key data below:"
                                                Foreground="#ccc" FontSize="12" />
                                            <TextBox Text="{Binding ImportKeyData}"
                                                Padding="10" MinHeight="200" TextWrapping="Wrap"
                                                AcceptsReturn="True" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                <Button Content="Cancel"
                                                    Command="{Binding CloseImportModalCommand}"
                                                    Classes="neutralButton" />
                                                <Button Content="Import"
                                                    Command="{Binding ImportKeyCommand}"
                                                    Classes="successButton"
                                                    IsEnabled="{Binding !IsLoading}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <!-- Export Modal -->
                                <Border Classes="modalScrim" IsVisible="{Binding IsExportModalVisible}"
                                    ZIndex="113">
                                    <Border Classes="modalCard" Width="700" Padding="22">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Exported Key" FontSize="{StaticResource TermoxTitleFontSize}"
                                                FontWeight="SemiBold" Foreground="#e0e0e0" />
                                            <TextBox Text="{Binding ExportedKeyData}"
                                                Background="#1e1e1e" Foreground="#e0e0e0"
                                                BorderBrush="#555" Padding="10"
                                                MinHeight="250" TextWrapping="Wrap"
                                                AcceptsReturn="True" IsReadOnly="True" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                <Button Content="Copy to Clipboard"
                                                    Command="{Binding CopyExportedKeyCommand}"
                                                    Classes="infoButton" />
                                                <Button Content="Close"
                                                    Command="{Binding CloseExportModalCommand}"
                                                    Classes="neutralButton" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                </Panel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FingerprintTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE90D;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Fingerprint Utilities" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Calculate and compare file or text fingerprints using various hash algorithms."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                                    RowSpacing="12" ColumnSpacing="12">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Algorithm:"
                                                        Foreground="#aaa" VerticalAlignment="Center"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                                        ItemsSource="{Binding SupportedAlgorithms}"
                                                        SelectedItem="{Binding SelectedAlgorithm}"
                                                        Background="#1e1e1e" Foreground="#e0e0e0"
                                                        BorderBrush="#555" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Text:"
                                                        Foreground="#aaa" VerticalAlignment="Top"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Grid.Row="1" Grid.Column="1"
                                                        Text="{Binding InputText}" PlaceholderText="Enter text or paste content"
                                                        Padding="10" MinHeight="100" TextWrapping="Wrap"
                                                        AcceptsReturn="True" />
                                                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                                        Content="Calculate Fingerprint"
                                                        Command="{Binding CalculateFingerprintCommand}"
                                                        Classes="primaryButton"
                                                        Padding="14,8" CornerRadius="4"
                                                        IsEnabled="{Binding !IsCalculating}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                                        Text="{Binding CalculationStatus}"
                                                        Foreground="{Binding CalculationStatusColor}"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Calculated Fingerprints" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <Border Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="Raw (uppercase hex):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding CalculatedFingerprint}"
                                                                PlaceholderText="Fingerprint will appear here after calculation"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopyCalculatedCommand}"
                                                                Classes="neutralButton"
                                                                Padding="10,4" CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="Formatted (pairs):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding FormattedFingerprint}"
                                                                PlaceholderText="Fingerprint will appear here after calculation"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopyFormattedCommand}"
                                                                Classes="neutralButton"
                                                                Padding="10,4" CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="SSH Style (colons):" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SshStyleFingerprint}"
                                                                PlaceholderText="Fingerprint will appear here after calculation"
                                                                Background="#1e1e1e" Foreground="#4caf50"
                                                                BorderBrush="#333" Padding="8" IsReadOnly="True"
                                                                TextWrapping="Wrap" />
                                                            <Button Content="Copy"
                                                                Command="{Binding CopySshStyleCommand}"
                                                                Classes="neutralButton"
                                                                Padding="10,4" CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Compare Fingerprints" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <Border Background="#252526" BorderBrush="#3a3a3a"
                                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*"
                                                        RowSpacing="10">
                                                        <StackPanel Grid.Row="0" Spacing="6">
                                                            <TextBlock Text="Expected Fingerprint:" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding ExpectedFingerprint}"
                                                                PlaceholderText="Paste expected fingerprint here"
                                                                Padding="10" MinHeight="60" TextWrapping="Wrap"
                                                                AcceptsReturn="True" />
                                                        </StackPanel>
                                                        <Button Grid.Row="1"
                                                            Content="Compare Fingerprints"
                                                            Command="{Binding CompareFingerprintsCommand}"
                                                            Classes="primaryButton"
                                                            Padding="14,8" CornerRadius="4"
                                                            HorizontalAlignment="Left" />
                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{Binding ComparisonStatus}"
                                                                Foreground="{Binding ComparisonStatusColor}"
                                                                FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="Clear All"
                                                Command="{Binding ClearCommand}"
                                                Classes="neutralButton"
                                                Padding="14,8" CornerRadius="4"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DnsTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="900">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE875;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="DNS Record Inspector" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="Query and inspect DNS records (A, AAAA, CNAME, MX, TXT, NS, SOA, SRV, PTR, CAA) for any domain."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*"
                                                        RowSpacing="10" ColumnSpacing="12">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Domain:"
                                                            Foreground="#aaa" VerticalAlignment="Center"
                                                            FontSize="12" FontWeight="SemiBold" />
                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                            Text="{Binding DomainName}" PlaceholderText="e.g., example.com"
                                                            Padding="10" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Record Type:"
                                                            Foreground="#aaa" VerticalAlignment="Center"
                                                            FontSize="12" FontWeight="SemiBold" />
                                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                            ItemsSource="{Binding SupportedRecordTypes}"
                                                            SelectedItem="{Binding SelectedRecordType}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Query Record Type"
                                                            Command="{Binding QueryDnsCommand}"
                                                            Classes="primaryButton"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsQuerying}"
                                                            HorizontalAlignment="Left" />
                                                        <Button Content="Query All Record Types"
                                                            Command="{Binding QueryAllCommand}"
                                                            Classes="successButton"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsQuerying}"
                                                            HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                        FontSize="12" TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Status}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Query Results" FontSize="14"
                                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                <ListBox ItemsSource="{Binding QueryResults}"
                                                    Background="#252526" BorderBrush="#333"
                                                    BorderThickness="1" Padding="8" MinHeight="150">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10" Background="#1e1e1e"
                                                                CornerRadius="3" Margin="0,2">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding RecordType, StringFormat='[{0}]'}"
                                                                        Foreground="#4caf50" FontWeight="SemiBold"
                                                                        Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DisplayText}"
                                                                        Foreground="#e0e0e0" TextWrapping="Wrap" />
                                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Detailed Results" FontSize="14"
                                    FontWeight="SemiBold" Foreground="#e0e0e0" />
                                <Border Background="#252526" BorderBrush="#333"
                                    BorderThickness="1" CornerRadius="4" Padding="12">
                                    <Grid RowDefinitions="*,Auto">
                                        <TextBox Grid.Row="0"
                                            Text="{Binding DetailedResult}"
                                            Background="#1e1e1e" Foreground="#4caf50"
                                            BorderBrush="#333" Padding="10"
                                            MinHeight="180" TextWrapping="Wrap"
                                            AcceptsReturn="True" IsReadOnly="True"
                                            FontFamily="{StaticResource TermoxMonoFontFamily}"
                                            FontSize="11" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Copy Results"
                                                Command="{Binding CopyResultCommand}"
                                                Classes="infoButton"
                                                Padding="12,6" CornerRadius="4" FontSize="11" />
                                            <Button Content="Clear"
                                                Command="{Binding ClearResultsCommand}"
                                                Classes="neutralButton"
                                                Padding="12,6" CornerRadius="4" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DataTemplate>

                            <DataTemplate DataType="vm:ServerStatsTabViewModel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1e1e1e" Padding="28">
                                        <StackPanel Spacing="16" MaxWidth="1100">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="42" Height="42" CornerRadius="9" Background="#1c2733" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE26B;" FontSize="21"
                                                        Foreground="#6ea9d4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="Server Stats" FontSize="{StaticResource TermoxPageTitleFontSize}"
                                                        FontWeight="SemiBold" Foreground="{StaticResource TermoxPageTitleBrush}" />
                                                    <TextBlock Text="CPU, memory, top processes, and disk usage collected over SSH from a saved session."
                                                        Foreground="{StaticResource TermoxPageSubtitleBrush}" FontSize="13" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Host selection -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <TextBlock Text="Host:" Foreground="#aaa"
                                                            VerticalAlignment="Center" FontSize="12"
                                                            FontWeight="SemiBold" />
                                                        <ComboBox Grid.Column="1"
                                                            ItemsSource="{Binding HostProfiles}"
                                                            SelectedItem="{Binding SelectedProfile}"
                                                            Background="#1e1e1e" Foreground="#e0e0e0"
                                                            BorderBrush="#555" Padding="10"
                                                            HorizontalContentAlignment="Stretch">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="2" Margin="2,3">
                                                                        <TextBlock Text="{Binding Name}"
                                                                            Foreground="#e5e5e5" FontSize="13" />
                                                                        <TextBlock Text="{Binding Host}"
                                                                            Foreground="#888" FontSize="11" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Collect Stats"
                                                            Command="{Binding CollectStatsCommand}"
                                                            Classes="primaryButton"
                                                            Padding="16,10" CornerRadius="4" FontSize="12"
                                                            IsEnabled="{Binding !IsCollecting}"
                                                            HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Status}"
                                                            Foreground="{Binding StatusColor}"
                                                            FontSize="12" VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding Status}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- System overview -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="System Overview" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Grid ColumnDefinitions="110,*,110,*,110,*" RowDefinitions="Auto,Auto"
                                                        RowSpacing="10" ColumnSpacing="8">
                                                        <TextBlock Text="OS" Foreground="#888" FontSize="11"
                                                            FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding OsInfo}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding OsInfo}" />
                                                        <TextBlock Grid.Column="2" Text="Kernel" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Kernel}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="Host" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Host}"
                                                            Foreground="#e0e0e0" FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="1" Text="Uptime" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Uptime}"
                                                            Foreground="#e0e0e0" FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Load Avg"
                                                            Foreground="#888" FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LoadAverage}"
                                                            Foreground="#e0e0e0" FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="CPU" Foreground="#888"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="5"
                                                            Text="{Binding CpuUsageDisplay}"
                                                            Foreground="{Binding CpuUsageColor}"
                                                            FontSize="14" FontWeight="SemiBold" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Summary strip: CPU / Memory / Disk -->
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                                <Border Background="#252526" BorderBrush="#3a3a3a"
                                                    BorderThickness="1" CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="CPU" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding CpuUsageDisplay}"
                                                                Foreground="{Binding CpuUsageColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#007acc"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding CpuBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding CpuSummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="#252526"
                                                    BorderBrush="#3a3a3a" BorderThickness="1"
                                                    CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Memory" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding MemoryUsedDisplay}"
                                                                Foreground="{Binding MemoryUsedColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#f39c12"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding MemoryBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding MemorySummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="#252526"
                                                    BorderBrush="#3a3a3a" BorderThickness="1"
                                                    CornerRadius="7" Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Disk" Foreground="#aaa"
                                                                FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding DiskUsedDisplay}"
                                                                Foreground="{Binding DiskUsedColor}"
                                                                FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <Border Background="#1e1e1e" CornerRadius="3" Height="8">
                                                            <Border CornerRadius="3" Background="#4caf50"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding DiskBarWidth}" Height="8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DiskSummary}" Foreground="#888"
                                                            FontSize="10" TextWrapping="Wrap" MinHeight="26" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Top CPU processes table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Top CPU Processes" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Shows the top 20 processes fetched over SSH."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="60,90,90,90,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="pid"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="PID" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding CpuIndicatorPid}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="User"
                                                                Classes="tableHeader" />
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="cpu"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="CPU %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding CpuIndicatorCpu}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="memory"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Mem %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding CpuIndicatorMemory}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortCpuCommand}" CommandParameter="name"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Command" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding CpuIndicatorName}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding TopCpuProcesses}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="180" MaxHeight="380">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="60,90,90,90,*">
                                                                        <TextBlock Text="{Binding Pid}" Foreground="#888"
                                                                            FontSize="11" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding User}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2"
                                                                            Text="{Binding CpuPercentDisplay}"
                                                                            Foreground="#4caf50" FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding MemPercentDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Command}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip.Tip="{Binding Command}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Top memory processes table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Top Memory Processes" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Shows the top 20 processes fetched over SSH."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="60,90,90,90,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="pid"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="PID" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding MemoryIndicatorPid}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="User"
                                                                Classes="tableHeader" />
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="memory"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Memory" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding MemoryIndicatorMemory}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="cpu"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Mem %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding MemoryIndicatorCpu}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortMemoryCommand}" CommandParameter="name"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Command" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding MemoryIndicatorName}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding TopMemoryProcesses}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="180" MaxHeight="380">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="60,90,90,90,*">
                                                                        <TextBlock Text="{Binding Pid}" Foreground="#888"
                                                                            FontSize="11" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding User}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2"
                                                                            Text="{Binding RssDisplay}"
                                                                            Foreground="#f39c12" FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding MemPercentDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Command}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip.Tip="{Binding Command}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Disk usage table -->
                                            <Border Background="#252526" BorderBrush="#3a3a3a"
                                                BorderThickness="1" CornerRadius="7" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Disk Usage" FontSize="14"
                                                            FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                        <TextBlock Text="Click a column header to sort. Sizes are shown in human-readable units."
                                                            Foreground="#888" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Background="#222222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                                        <Grid ColumnDefinitions="110,90,90,90,70,*">
                                                            <Button Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Filesystem"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Filesystem" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding DiskIndicatorFilesystem}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Size"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Size" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorSize}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Used"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Used" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorUsed}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="Available"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Available" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorAvailable}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="UsePercent"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="Use %" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding DiskIndicatorUsePercent}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="5" Classes="tableHeader"
                                                                Command="{Binding SortDiskCommand}" CommandParameter="MountedOn"
                                                                HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Text="Mounted On" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding DiskIndicatorMountedOn}"
                                                                        Foreground="#6ea9d4" FontSize="9" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding Disks}"
                                                        Background="#1a1a1a" BorderBrush="#333"
                                                        BorderThickness="1" MinHeight="150" MaxHeight="320">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10,6" BorderBrush="#2d2d2d"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="110,90,90,90,70,*">
                                                                        <TextBlock Text="{Binding Filesystem}"
                                                                            Foreground="#aaa" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                                                            Foreground="#e0e0e0" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding UsedDisplay}"
                                                                            Foreground="#888" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="3"
                                                                            Text="{Binding AvailableDisplay}"
                                                                            Foreground="#4caf50" FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="4"
                                                                            Text="{Binding UsePercentDisplay}"
                                                                            Foreground="#f39c12" FontSize="11"
                                                                            HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="5"
                                                                            Text="{Binding MountedOn}"
                                                                            Foreground="#888" FontSize="11"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ToolsTabViewModel">
                                <TabControl Background="{StaticResource TermoxPanelBrush}" Padding="0">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="MinHeight" Value="39" />
                                            <Setter Property="Padding" Value="5,5,5,7" />
                                            <Setter Property="Foreground" Value="{StaticResource TermoxMutedBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border Background="Transparent"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            BorderBrush="{TemplateBinding BorderBrush}">
                                                            <ContentPresenter Name="PART_Content"
                                                                Content="{TemplateBinding Header}"
                                                                RecognizesAccessKey="True"
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style Selector="TabItem:selected">
                                            <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Setter Property="BorderBrush" Value="#007acc" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabItem Header="Port Scanner" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Port Scanner" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Scan Host" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding ScanHost}"
                                                        Margin="0,0,0,10" />
                                                    <TextBlock Text="Ports (comma-separated)"
                                                        Foreground="#aaaaaa" FontSize="12"
                                                        FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding ScanPorts}"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Start Scan"
                                                        Command="{Binding ScanPortsCommand}"
                                                        Classes="primaryButton"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsScanning}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding ScanResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="Auto, *, Auto"
                                                                    Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding Port}"
                                                                        Foreground="#ccc"
                                                                        FontWeight="SemiBold"
                                                                        Width="50" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text=" - " Foreground="#888" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding Status}"
                                                                        Foreground="{Binding StatusColor}"
                                                                        FontWeight="SemiBold" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Ping Test" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Ping Test" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Target Host"
                                                        Foreground="#aaaaaa" FontSize="12"
                                                        FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding PingHost}"
                                                        Margin="0,0,0,10" />
                                                    <TextBlock Text="Count" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <NumericUpDown Value="{Binding PingCount}"
                                                        Minimum="1" Maximum="10"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Start Ping"
                                                        Command="{Binding PingCommand}"
                                                        Classes="primaryButton"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsPinging}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding PingResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="Auto, *, Auto"
                                                                    Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding Sequence}"
                                                                        Foreground="#ccc"
                                                                        FontWeight="SemiBold"
                                                                        Width="30" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="seq" Foreground="#888" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding Response}"
                                                                        Foreground="{Binding ResponseColor}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="SSH Key Generator" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="SSH Key Generator"
                                                        FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock Text="Key Type" Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <ComboBox ItemsSource="{Binding KeyTypes}"
                                                        SelectedItem="{Binding SelectedKeyType}"
                                                        Background="#252526" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#555"
                                                        Padding="8" CornerRadius="4"
                                                        Margin="0,0,0,10">
                                                    </ComboBox>
                                                    <StackPanel Spacing="6"
                                                        IsVisible="{Binding IsRsaKeySelected}">
                                                        <TextBlock Text="Key Size (RSA only)"
                                                            Foreground="#aaaaaa" FontSize="12"
                                                            FontWeight="SemiBold" />
                                                        <NumericUpDown Value="{Binding KeySize}"
                                                            Minimum="1024" Maximum="4096"
                                                            Margin="0,0,0,10" />
                                                    </StackPanel>
                                                    <Button Content="Generate Key"
                                                        Command="{Binding GenerateKeyCommand}"
                                                        Classes="primaryButton"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsGeneratingKey}"
                                                        HorizontalAlignment="Left" />
                                                    <TextBlock Text="Public Key"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold"
                                                        Margin="0,6,0,0" />
                                                    <TextBox Text="{Binding GeneratedPublicKey}"
                                                        Background="#1a1a1a" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#333"
                                                        Padding="8" CornerRadius="4" Height="60"
                                                        IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                        FontSize="12" />
                                                    <Button Content="Copy Public Key"
                                                        Command="{Binding CopyPublicKeyCommand}"
                                                        Classes="neutralButton"
                                                        Padding="10,6" CornerRadius="4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Left" />
                                                    <TextBlock Text="Private Key"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold"
                                                        Margin="0,6,0,0" />
                                                    <TextBox Text="{Binding GeneratedPrivateKey}"
                                                        Background="#1a1a1a" Foreground="#e0e0e0"
                                                        BorderThickness="1" BorderBrush="#333"
                                                        Padding="8" CornerRadius="4" Height="120"
                                                        IsReadOnly="True" TextWrapping="Wrap"
                                                        FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                        FontSize="12" />
                                                    <Button Content="Copy Private Key"
                                                        Command="{Binding CopyPrivateKeyCommand}"
                                                        Classes="neutralButton"
                                                        Padding="10,6" CornerRadius="4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Connection Tester" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Connection Tester"
                                                        FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock
                                                        Text="Batch test all saved connections for connectivity."
                                                        Foreground="#aaaaaa" FontSize="12" />
                                                    <Button Content="Test All Connections"
                                                        Command="{Binding TestAllConnectionsCommand}"
                                                        Classes="primaryButton"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsTesting}"
                                                        HorizontalAlignment="Left" />
                                                    <ListBox ItemsSource="{Binding TestResults}"
                                                        Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" MaxHeight="400">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    ColumnDefinitions="*, Auto, Auto"
                                                                    Margin="0,3" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding ProfileName}"
                                                                        Foreground="#e0e0e0"
                                                                        FontWeight="SemiBold"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                        Text="{Binding Status}"
                                                                        Foreground="{Binding StatusColor}"
                                                                        FontWeight="SemiBold"
                                                                        Width="80" />
                                                                    <TextBlock Grid.Column="2"
                                                                        Text="{Binding ResponseTime}"
                                                                        Foreground="#888"
                                                                        FontSize="11"
                                                                        Width="120" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="SSH Endpoint Test" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Padding="16">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Speed Test" FontSize="14"
                                                        FontWeight="SemiBold" Foreground="#e0e0e0" />
                                                    <Rectangle Height="1" Fill="#444"
                                                        Margin="0,0,0,6" />
                                                    <TextBlock
                                                        Text="Test upload/download speeds over SFTP."
                                                        Foreground="#aaaaaa" FontSize="12" />
                                                    <TextBlock Text="Target Host"
                                                        Foreground="#aaaaaa"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding SpeedTestHost}"
                                                        PlaceholderText="hostname or IP, e.g. 127.0.0.1:2222"
                                                        Margin="0,0,0,10" />
                                                    <Button Content="Test SSH Endpoint"
                                                        Command="{Binding RunSpeedTestCommand}"
                                                        Classes="primaryButton"
                                                        Padding="12,7" CornerRadius="4"
                                                        FontSize="12"
                                                        IsEnabled="{Binding !IsSpeedTesting}"
                                                        HorizontalAlignment="Left" />
                                                    <Border Background="#1a1a1a" BorderThickness="1"
                                                        BorderBrush="#333" CornerRadius="4"
                                                        Padding="10">
                                                        <TextBlock Text="{Binding SpeedTestResult}"
                                                            Foreground="#ccc" TextWrapping="Wrap"
                                                            FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                            FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ChatTabViewModel">
                                <Panel Background="#1e1e1e" Margin="8" Loaded="ChatTabRoot_Loaded">
                                <Grid RowDefinitions="Auto,*,Auto,Auto">
                                    <!-- Header -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="2,0,2,8">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="Helm" FontWeight="SemiBold"
                                                Foreground="#e0e0e0" FontSize="14" />
                                            <TextBlock Text="your SSH &amp; SFTP copilot" Foreground="#777777"
                                                FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                            Command="{Binding NewChatCommand}"
                                            Classes="toolButton" Padding="9,5" Margin="0,0,5,0"
                                            ToolTip.Tip="New chat">
                                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE266;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3"
                                            Command="{Binding OpenHistoryCommand}"
                                            Classes="toolButton" Padding="8,5" Margin="0,0,5,0"
                                            ToolTip.Tip="Chat history">
                                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE889;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="4"
                                            Command="{Binding ClearTranscriptCommand}"
                                            Classes="toolButton" Padding="8,5" Margin="0,0,5,0"
                                            ToolTip.Tip="Clear transcript">
                                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE92E;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="5"
                                            Command="{Binding OpenSettingsCommand}"
                                            Classes="toolButton" Padding="8,5" Margin="0"
                                            ToolTip.Tip="Settings">
                                            <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE8B8;" FontSize="13" />
                                        </Button>
                                    </Grid>

                                    <!-- Transcript: styled after the Claude Code VS Code extension — a flat,
                                         linear log rather than chat bubbles. User turns get a subtle bordered
                                         box; everything else (assistant prose, tool calls, tool results) flows
                                         inline, separated by hairlines, with tool activity rendered the way
                                         Claude Code's own CLI narrates it: "● tool(args)" then "⎿ result". -->
                                    <Grid Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled"
                                            Loaded="ChatTranscript_Loaded" Unloaded="ChatTranscript_Unloaded">
                                        <ItemsControl ItemsSource="{Binding Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:ChatMessage">
                                                    <StackPanel Margin="0,3">
                                                        <!-- User turn -->
                                                        <Border IsVisible="{Binding IsUser}" Background="#252526"
                                                            BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,7" Margin="0,7,0,3">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="You" FontWeight="SemiBold"
                                                                    Foreground="#8a8a8a" FontSize="10" />
                                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                    Foreground="#d4d4d4" FontSize="13" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Assistant / tool / error turn -->
                                                        <StackPanel IsVisible="{Binding !IsUser}" Spacing="3"
                                                            Margin="0,5,0,5">
                                                            <!-- Role/status line: same helm glyph always sits in the same
                                                                 spot — no rotation/motion at all (it was overflowing its
                                                                 box and getting clipped by the transcript's disabled
                                                                 horizontal scrollbar), just a plain opacity pulse. -->
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding IsAssistant}">
                                                                <StackPanel.Styles>
                                                                    <Style Selector="TextBlock.helmPulse">
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1"
                                                                                IterationCount="INFINITE">
                                                                                <KeyFrame Cue="0%">
                                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                                </KeyFrame>
                                                                                <KeyFrame Cue="50%">
                                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                                </KeyFrame>
                                                                                <KeyFrame Cue="100%">
                                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                                </KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </StackPanel.Styles>
                                                                <TextBlock Text="⎈" FontSize="11"
                                                                    Foreground="#5bc0de" VerticalAlignment="Center"
                                                                    Classes.helmPulse="{Binding IsWaitingForContent}" />
                                                                <TextBlock Text="Helm" FontWeight="SemiBold"
                                                                    Foreground="#5bc0de" FontSize="10"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusText}" Foreground="#777777"
                                                                    FontSize="10.5" VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsWaitingForContent}" />
                                                            </StackPanel>
                                                            <TextBlock Text="⚠ Error" FontWeight="SemiBold"
                                                                Foreground="#f44336" FontSize="10"
                                                                IsVisible="{Binding IsError}" />

                                                            <!-- Tool call announcement: "● tool(args)" -->
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                Foreground="#5bc0de" FontSize="12.5"
                                                                FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                                Margin="15,0,0,0"
                                                                IsVisible="{Binding HasToolCalls}" />

                                                            <!-- Tool result: "⎿ ..." -->
                                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsTool}"
                                                                Margin="15,0,0,0">
                                                                <TextBlock Grid.Column="0" Text="⎿"
                                                                    Foreground="#6a6a6a" FontSize="12.5"
                                                                    FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                                    Margin="0,0,6,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                                    TextWrapping="Wrap" Foreground="#8a8a8a"
                                                                    FontSize="12" FontFamily="{StaticResource TermoxMonoFontFamily}" />
                                                            </Grid>

                                                            <!-- Plain prose reply, with a copy icon to its right.
                                                                 Right margin keeps the button clear of the
                                                                 transcript's scrollbar track so it doesn't intercept
                                                                 clicks meant for the button. -->
                                                            <Grid ColumnDefinitions="*,Auto" Margin="15,0,12,0"
                                                                IsVisible="{Binding IsPlainAssistantReply}">
                                                                <ContentControl Grid.Column="0"
                                                                    Content="{Binding Content, Converter={x:Static services:MarkdownContentConverter.Instance}}"
                                                                    HorizontalContentAlignment="Stretch" />
                                                                <Button Grid.Column="1" Content="⎘"
                                                                    Click="CopyMessage_Click" Tag="{Binding}"
                                                                    Classes="toolButton" Padding="5,3" FontSize="12"
                                                                    Margin="4,0,0,0" VerticalAlignment="Top"
                                                                    ToolTip.Tip="Copy response" />
                                                            </Grid>

                                                            <!-- Error text -->
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                Foreground="#f2a0a0" FontSize="12.5"
                                                                Margin="15,0,0,0"
                                                                IsVisible="{Binding IsError}" />
                                                        </StackPanel>

                                                        <Rectangle Height="1" Fill="#262626" Margin="0,4,0,0"
                                                            IsVisible="{Binding IsPlainAssistantReply}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Sticky question: same-styled copy of whichever "You" bubble you've
                                             scrolled past, so it stays visible while reading the reply beneath
                                             it — like Claude Code's VS Code extension pinning the prompt while
                                             you scroll its response. Tracks the message nearest above the
                                             viewport (not just the newest one), and is fully code-behind driven
                                             (scroll position), not bound to the view model. -->
                                        <Border Name="PinnedQuestionBar" IsVisible="False" Cursor="Hand"
                                            VerticalAlignment="Top" Background="#252526"
                                            BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="4"
                                            Padding="10,7" Margin="0,7,0,0"
                                            ToolTip.Tip="Click to show the full question">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="You" FontWeight="SemiBold"
                                                        Foreground="#8a8a8a" FontSize="10" />
                                                    <TextBlock Grid.Column="1" Name="PinnedQuestionChevron"
                                                        Text="⌄" Foreground="#6a6a6a" FontSize="11" />
                                                </Grid>
                                                <TextBlock Name="PinnedQuestionText" Foreground="#d4d4d4"
                                                    FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Empty state: shown until the first message, so a fresh chat reads
                                             as "ready and here's what I can do" instead of a blank void. -->
                                        <StackPanel IsVisible="{Binding !HasMessages}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="7" MaxWidth="380">
                                            <TextBlock Text="⎈" FontSize="32" Foreground="#5bc0de"
                                                HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Hi, I'm Helm" FontWeight="SemiBold" FontSize="17.5"
                                                Foreground="#e0e0e0" HorizontalAlignment="Center" />
                                            <TextBlock
                                                Text="I can inspect and operate on your saved SSH &amp; SFTP connections — run commands, browse files, check DNS, and more."
                                                Foreground="#8a8a8a" FontSize="13.5" TextWrapping="Wrap"
                                                TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <Button Classes="toolButton" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" Margin="0,0,0,0"
                                                Content="List my saved connections" FontSize="13.5"
                                                Command="{Binding UseSuggestedPromptCommand}"
                                                CommandParameter="List my saved connections." />
                                            <Button Classes="toolButton" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" Margin="0,0,0,0"
                                                Content="Check disk usage and memory on my server" FontSize="13.5"
                                                Command="{Binding UseSuggestedPromptCommand}"
                                                CommandParameter="Check disk usage and memory on my server." />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tool-call approval banner -->
                                    <Border Grid.Row="2" IsVisible="{Binding HasPendingApproval}"
                                        BorderBrush="#f39c12" BorderThickness="0,0,0,0" Margin="0,8,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"
                                            Background="#1f1a14">
                                            <Border Grid.Column="0" Width="3" Background="#f39c12" />
                                            <TextBlock Grid.Column="1" Text="{Binding PendingApprovalDescription}"
                                                Foreground="#e0b673" FontSize="12" TextWrapping="Wrap"
                                                FontFamily="{StaticResource TermoxMonoFontFamily}"
                                                VerticalAlignment="Center" Margin="10,8" />
                                            <Button Grid.Column="2" Content="Approve"
                                                Command="{Binding ApproveToolCallCommand}"
                                                Classes="primaryButton" Padding="10,5" CornerRadius="4"
                                                FontSize="11.5" Margin="0,8" VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            <Button Grid.Column="3" Content="Deny"
                                                Command="{Binding DenyToolCallCommand}"
                                                Classes="neutralButton" Padding="10,5" CornerRadius="4"
                                                FontSize="11.5" Margin="0,8,10,8" VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Input row -->
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="0">
                                        <!-- Server picker: an inline panel, not a Flyout/Popup — those anchor and
                                             size relative to their trigger, which fought being flush and
                                             full-width against the composer below it. As a plain sibling in this
                                             same StackPanel it matches the composer's width automatically and
                                             sits directly on top of it with zero gap, like one continuous block. -->
                                        <Border Name="ServerPickerPanel" IsVisible="{Binding IsServerPickerOpen}"
                                            Background="#1e1e1e" BorderBrush="#3a3a3a" BorderThickness="1"
                                            CornerRadius="8" Padding="6" Margin="0,0,0,8">
                                            <Border.Styles>
                                                <Style Selector="Button.serverPickRow">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="8,6" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                                <Style Selector="Button.serverPickRow:pointerover">
                                                    <Setter Property="Background" Value="#2a2a2e" />
                                                </Style>
                                            </Border.Styles>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Select a server" Foreground="#8a8a8a"
                                                    FontSize="11" FontWeight="SemiBold" Margin="8,4,8,8" />
                                                <Button Classes="serverPickRow" Command="{Binding ClearServerScopeCommand}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                            <TextBlock Text="All servers"
                                                                Foreground="#e0e0e0" FontSize="13"
                                                                FontWeight="SemiBold" />
                                                            <TextBlock
                                                                Text="Tools ask for a server profile each time"
                                                                Foreground="#777777" FontSize="10.5" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="✓"
                                                            Foreground="#5bc0de" FontSize="13"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsServerScoped}" />
                                                    </Grid>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding SavedConnections}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:SshConnectionProfile">
                                                            <Button Classes="serverPickRow"
                                                                Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).SelectServerCommand}"
                                                                CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                                        <TextBlock Text="{Binding Name}"
                                                                            Foreground="#e0e0e0" FontSize="13"
                                                                            FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Host}"
                                                                            Foreground="#777777" FontSize="10.5" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="✓"
                                                                        Foreground="#5bc0de" FontSize="13"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding Converter="{x:Static services:ProfileMatchConverter.Instance}">
                                                                                <Binding />
                                                                                <Binding Path="$parent[ItemsControl].((vm:ChatTabViewModel)DataContext).SelectedServerProfile" />
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Composer card: one bordered container holding both the text field
                                             and its toolbar row, matching the Claude Code extension's input box
                                             — no separate boxed TextBox + detached caption line underneath. -->
                                        <Border Background="#181818" BorderBrush="#3a3a3a" BorderThickness="1"
                                            CornerRadius="14" Padding="12,10,10,8">
                                            <Border.Styles>
                                                <Style Selector="Button.chatSendBtn">
                                                    <Setter Property="Background" Value="#5bc0de" />
                                                    <Setter Property="Foreground" Value="#0e1414" />
                                                    <Setter Property="Width" Value="30" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="CornerRadius" Value="15" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                                <Style Selector="Button.chatSendBtn:disabled">
                                                    <Setter Property="Background" Value="#3a3a3e" />
                                                    <Setter Property="Foreground" Value="#6a6a6e" />
                                                </Style>
                                                <Style Selector="Button.chatComposerChip">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="6,3" />
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="CornerRadius" Value="5" />
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                                <Style Selector="Button.chatComposerChip:pointerover">
                                                    <Setter Property="Background" Value="#2a2a2e" />
                                                </Style>
                                                <!-- FluentTheme's TextBox draws its own black fill and blue
                                                     accent focus ring regardless of the Background/BorderThickness
                                                     set on the instance — those only cover the default state, not
                                                     :focus/:pointerover, which the theme overrides itself. Naming
                                                     every state explicitly here is what actually defeats it. -->
                                                <Style Selector="TextBox.chatComposerInput">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                                <Style Selector="TextBox.chatComposerInput:pointerover /template/ Border#PART_BorderElement">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <Style Selector="TextBox.chatComposerInput:focus /template/ Border#PART_BorderElement">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <!-- Same problem while streaming disables the box: FluentTheme's
                                                     :disabled state has its own washed-out fill that doesn't
                                                     match the composer card either. -->
                                                <Style Selector="TextBox.chatComposerInput:disabled /template/ Border#PART_BorderElement">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <Style Selector="TextBox.chatComposerInput:disabled">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </Style>
                                            </Border.Styles>
                                            <StackPanel Spacing="6">
                                                <TextBox Classes="chatComposerInput" Text="{Binding DraftInput}"
                                                    PlaceholderText="Ask about your servers…"
                                                    AcceptsReturn="True" TextWrapping="Wrap"
                                                    MaxHeight="160" VerticalContentAlignment="Top"
                                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                    IsEnabled="{Binding !IsStreaming}"
                                                    Loaded="ChatDraftInput_Loaded"
                                                    FocusAdorner="{x:Null}"
                                                    Padding="2,0" FontSize="13.5" />
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <Button Grid.Column="0" Classes="chatComposerChip"
                                                        Command="{Binding ToggleServerPickerCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                Fill="{Binding SelectedServerProfile.IsConnected, FallbackValue=#555555, TargetNullValue=#555555, Converter={x:Static services:ConnectedDotConverter.Instance}}" />
                                                            <TextBlock
                                                                Text="{Binding SelectedServerProfile.Name, FallbackValue='All servers', TargetNullValue='All servers'}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedModel.Label}"
                                                        Foreground="#5a5a5a" FontSize="11.5"
                                                        VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <Button Grid.Column="3" Content="↑" Classes="chatSendBtn"
                                                        Command="{Binding SendMessageCommand}"
                                                        IsVisible="{Binding !IsStreaming}" ToolTip.Tip="Send" />
                                                    <Button Grid.Column="3" Content="■" Classes="chatSendBtn"
                                                        FontSize="11" Command="{Binding CancelStreamingCommand}"
                                                        IsVisible="{Binding IsStreaming}" ToolTip.Tip="Stop" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Settings and History float above the transcript/composer
                                     instead of being laid out in the Grid's row flow, which
                                     used to push everything below them down the page whenever
                                     either was opened. -->
                                <Border IsVisible="{Binding IsSettingsPanelOpen}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="460" MaxHeight="480" Margin="0,46,0,0"
                                    Background="#161616" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12,6,12" ZIndex="10"
                                    BoxShadow="0 8 24 0 #66000000">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Inference endpoint" Foreground="#e0e0e0"
                                                FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Base URL (OpenAI-compatible, e.g. https://api.openai.com/v1)"
                                                Foreground="#aaaaaa" FontSize="11" />
                                            <TextBox Text="{Binding BaseUrl}"
                                                PlaceholderText="https://api.openai.com/v1" />
                                            <TextBlock Text="Model" Foreground="#aaaaaa" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding ModelOptions}"
                                                SelectedItem="{Binding SelectedModel}"
                                                HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="services:ChatModelInfo">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Text="{Binding CustomModelId}"
                                                IsVisible="{Binding IsCustomModelSelected}"
                                                PlaceholderText="custom-model-id" />
                                            <TextBlock Text="This model isn't in the known list — tool calling support isn't guaranteed."
                                                Foreground="#f39c12" FontSize="11" TextWrapping="Wrap"
                                                IsVisible="{Binding IsModelUnrecognized}" />
                                            <TextBlock Text="API Key" Foreground="#aaaaaa" FontSize="11" />
                                            <TextBox Text="{Binding ApiKey}" PasswordChar="•" />
                                            <TextBlock Text="Temperature" Foreground="#aaaaaa" FontSize="11" />
                                            <NumericUpDown Value="{Binding Temperature}"
                                                Minimum="0" Maximum="2" Increment="0.1"
                                                HorizontalAlignment="Left" Width="140" />
                                            <TextBlock Text="Context window (tokens)"
                                                Foreground="#aaaaaa" FontSize="11" />
                                            <TextBlock Text="How much conversation history to send per request. Picking a known model above fills this in automatically."
                                                Foreground="#777777" FontSize="10" TextWrapping="Wrap" />
                                            <NumericUpDown Value="{Binding ContextWindowTokens}"
                                                Minimum="1000" Maximum="2000000" Increment="1000"
                                                FormatString="0"
                                                HorizontalAlignment="Left" Width="160" />
                                            <CheckBox Content="Auto-approve read-only tools"
                                                IsChecked="{Binding AutoApproveReadOnlyTools}"
                                                Foreground="#ccc" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Save" Command="{Binding SaveSettingsCommand}"
                                                    Classes="primaryButton" Padding="14,7" CornerRadius="4"
                                                    FontSize="12" />
                                                <Button Content="Close" Command="{Binding CloseSettingsCommand}"
                                                    Classes="neutralButton" Padding="14,7" CornerRadius="4"
                                                    FontSize="12" Margin="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <Border IsVisible="{Binding IsHistoryPanelOpen}"
                                    Background="#161616" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12,6,12" MaxHeight="400"
                                    Width="400" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,46,0,0" ZIndex="10" BoxShadow="0 8 24 0 #66000000">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                            <TextBlock Grid.Column="0" Text="Chat history" Foreground="#e0e0e0"
                                                FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="+ New Chat"
                                                Command="{Binding NewChatCommand}"
                                                Classes="toolButton" Padding="8,4" FontSize="11" Margin="0" />
                                        </Grid>
                                        <TextBox Grid.Row="1" Text="{Binding HistorySearchQuery}"
                                            PlaceholderText="Search sessions…" Padding="8,6" FontSize="12"
                                            Margin="0,0,0,8" />
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                                            <ItemsControl ItemsSource="{Binding HistorySessions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:ChatSessionSummary">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                                            <Panel Grid.Column="0">
                                                                <Button IsVisible="{Binding !IsEditing}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).LoadSessionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Classes="toolButton" Padding="8,6" FontSize="12" Margin="0">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                            Foreground="#e0e0e0" FontSize="12"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, Converter={x:Static services:RelativeTimeConverter.Instance}}"
                                                                            Foreground="#777777" FontSize="10.5"
                                                                            VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </Button>
                                                                <TextBox IsVisible="{Binding IsEditing}"
                                                                    Text="{Binding Title, Mode=TwoWay}"
                                                                    FontSize="12" Padding="8,6"
                                                                    Loaded="RenameTitleTextBox_Loaded"
                                                                    KeyDown="RenameTitleTextBox_KeyDown"
                                                                    LostFocus="RenameTitleTextBox_LostFocus" />
                                                            </Panel>
                                                            <Button Grid.Column="1" IsVisible="{Binding !IsEditing}"
                                                                Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).RenameSessionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="toolButton" Padding="8,6" Margin="4,0,0,0"
                                                                VerticalAlignment="Stretch"
                                                                VerticalContentAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                ToolTip.Tip="Rename this session">
                                                                <TextBlock FontFamily="{StaticResource MaterialIconFont}" Text="&#xE3C9;" FontSize="13" />
                                                            </Button>
                                                            <Button Grid.Column="2" Content="🗑" IsVisible="{Binding !IsEditing}"
                                                                Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).DeleteSessionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="toolButton" Padding="8,6" FontSize="13"
                                                                Margin="4,0,0,0" VerticalAlignment="Stretch"
                                                                VerticalContentAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                ToolTip.Tip="Delete this session" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Text="No saved chats yet — send a message to start one."
                                            Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                                            IsVisible="{Binding !HistorySessions.Count}" Margin="0,4,0,0" />
                                        <Button Grid.Row="3" Content="Close" Command="{Binding CloseHistoryCommand}"
                                            Classes="toolButton" Padding="12,7" FontSize="12" Margin="0,8,0,0" />
                                    </Grid>
                                </Border>
                                </Panel>
                            </DataTemplate>
                    </Grid.DataTemplates>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition
                                Width="{Binding IsSplitViewActive, Converter={x:Static services:BoolToGridLengthConverter.Instance}, ConverterParameter=6}" />
                            <ColumnDefinition
                                Width="{Binding IsSplitViewActive, Converter={x:Static services:BoolToGridLengthConverter.Instance}, ConverterParameter=*}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource TermoxPanelBrush}">
                            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                                <TabControl.Styles>
                                    <!-- Flat active-tab accent, matching the nav rail's #007acc indicator and ToolsTab's own sub-tab treatment -->
                                    <Style Selector="TabItem">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="14,0" />
                                        <Setter Property="Foreground" Value="{StaticResource TermoxMutedBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Name="PART_Content"
                                                            Content="{TemplateBinding Header}"
                                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                            RecognizesAccessKey="True"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style Selector="TabItem:pointerover">
                                        <Setter Property="Background" Value="{StaticResource TermoxSurfaceHoverBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
                                    </Style>
                                    <Style Selector="TabItem:selected">
                                        <Setter Property="Background" Value="{StaticResource TermoxSurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TermoxTextPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="#007acc" />
                                    </Style>
                                </TabControl.Styles>
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Close"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseTabCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <MenuItem Header="Close Others"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseOtherTabsCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Close Tabs to the Left"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseTabsToLeftCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <MenuItem Header="Close Tabs to the Right"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseTabsToRightCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Close All"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseAllTabsCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Open in Split View"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenInSplitViewCommand}"
                                                        CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                FontSize="13" />
                                            <Button Content="✕"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseTabCommand}"
                                                CommandParameter="{Binding}" Classes="closeTabBtn"
                                                Foreground="#888" Background="Transparent"
                                                BorderThickness="0" Padding="2" FontSize="10"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                            </TabControl>
                        </Border>

                        <!-- Split view: a second pane pinned to one tab (e.g. Chat next to SFTP),
                             independent of the main tab strip's selection. -->
                        <GridSplitter Grid.Column="1" Width="6" Background="#333333"
                            IsVisible="{Binding IsSplitViewActive}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ResizeDirection="Columns" />
                        <Grid Grid.Column="2" IsVisible="{Binding IsSplitViewActive}"
                            RowDefinitions="Auto,*" Background="#1e1e1e">
                            <Border Grid.Row="0" Background="#252526" BorderBrush="#333333"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SecondaryTab.Title}"
                                        Foreground="#e0e0e0" FontSize="13" VerticalAlignment="Center"
                                        Margin="10,8" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseSplitViewCommand}"
                                        Classes="closeTabBtn" Foreground="#888" Background="Transparent"
                                        BorderThickness="0" Padding="6" FontSize="11"
                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                        ToolTip.Tip="Close split view" />
                                </Grid>
                            </Border>
                            <ContentControl Grid.Row="1" Content="{Binding SecondaryTab}" />
                        </Grid>
                    </Grid>

                    <Border IsVisible="{Binding !HasTabs}" Background="#1e1e1e">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" Width="360">
                            <Image Source="/Assets/Icons/termox-icon.png" Width="72" Height="72"
                                HorizontalAlignment="Center" Opacity="0.9" />
                            <TextBlock Text="Welcome to Termox" Foreground="#f1f5f9"
                                FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Your secure SSH and SFTP workspace"
                                Foreground="#9aa4b2" FontSize="13" HorizontalAlignment="Center" />
                            <Button Command="{Binding ShowConnectionModalCommand}"
                                Classes="newConnectionButton" Padding="18,10"
                                HorizontalAlignment="Center" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="+" FontSize="16"
                                        FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="New Connection"
                                        FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Double-click a saved session to open it, or use the Tools tab for network utilities."
                                Foreground="#737d8a" FontSize="11" TextWrapping="Wrap"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <Border Background="#2d2d30" BorderBrush="#f39c12" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="20" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" MaxWidth="520" ZIndex="200"
            IsVisible="{Binding IsEditorStatusVisible}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding EditorStatusMessage}" Foreground="#f5f5f5"
                    TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕"
                    Command="{Binding ClearEditorStatusCommand}"
                    Background="Transparent" Foreground="#aaa" BorderThickness="0" />
            </Grid>
        </Border>

        <!--
            Modal ZIndex convention: 100-111 = the 12 top-level modals below, sequential in the
            order they appear in this file. 112-113 = the GPG-nested Import/Export modals (only
            need to beat siblings within the GPG tab's own Panel, but numbered in this band so
            the convention reads as one system). 20/21/30 = the 3 tab-local nested modals
            (SFTP delete/size-warning, FileEditor save-confirm) — local stacking only, not
            compared against this band.
        -->
        <!-- Connection Modal Overlay -->
        <Border Classes="modalScrim" IsVisible="{Binding IsConnectionModalVisible}" ZIndex="100">
            <Border Classes="modalCard" Width="640" MaxWidth="760" MaxHeight="640" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Background="#252932" Padding="22,16"
                        BorderBrush="#3c4350" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="New Connection Profile" FontWeight="SemiBold"
                                    FontSize="{StaticResource TermoxTitleFontSize}" Foreground="#f3f5f7" />
                                <TextBlock Text="Server, authentication, and connection behavior"
                                    Foreground="#9aa4b2" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                Command="{Binding HideConnectionModalCommand}"
                                Background="Transparent" Foreground="#aeb7c4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                FontSize="16" BorderThickness="0" Padding="8" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,18" Spacing="16">
                            <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                RowSpacing="9">
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Text="SERVER" Foreground="#6ea9d4" FontSize="10"
                                    FontWeight="Bold" LetterSpacing="1.2" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Connection Name" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding ConnectionName}"
                                        Classes="connectionInput" PlaceholderText="My Server" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Remote Host" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding Host}" Classes="connectionInput"
                                        PlaceholderText="example.com" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Username" Foreground="#aaaaaa" FontSize="12" />
                                    <TextBox Text="{Binding Username}" Classes="connectionInput"
                                        PlaceholderText="user" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Port" Foreground="#aaaaaa" FontSize="12" />
                                    <TextBox Text="{Binding Port}" Classes="connectionInput"
                                        PlaceholderText="22" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="#3c4350" />

                            <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="9">
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Text="AUTHENTICATION" Foreground="#6ea9d4" FontSize="10"
                                    FontWeight="Bold" LetterSpacing="1.2" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Password" Foreground="#aaaaaa" FontSize="12" />
                                    <TextBox Text="{Binding Password}" Classes="connectionInput"
                                        PasswordChar="•"
                                        ToolTip.Tip="Account password (leave blank for key-based auth)" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Key Passphrase" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding PrivateKeyPassphrase}"
                                        Classes="connectionInput" PasswordChar="•"
                                        ToolTip.Tip="Passphrase for the private key, if it has one" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    Spacing="5">
                                    <TextBlock Text="Private Key File" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath}"
                                            Classes="connectionInput"
                                            PlaceholderText="/path/to/id_rsa" />
                                        <Button Grid.Column="1" Content="Browse..."
                                            Click="BrowsePrivateKey_Click"
                                            Classes="neutralButton" Padding="12,8"
                                            Margin="8,0,0,0" CornerRadius="4"
                                            ToolTip.Tip="Browse for Private Key" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="#3c4350" />

                            <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="9">
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Text="CONNECTION BEHAVIOR" Foreground="#6ea9d4"
                                    FontSize="10" FontWeight="Bold" LetterSpacing="1.2" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Retry Count" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding ConnectionRetryCount}"
                                        Classes="connectionInput"
                                        ToolTip.Tip="Connection attempts (min 1)" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Retry Delay (s)" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding ConnectionRetryDelaySeconds}"
                                        Classes="connectionInput"
                                        ToolTip.Tip="Seconds between attempts" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Keep-Alive (s)" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding KeepAliveIntervalSeconds}"
                                        Classes="connectionInput"
                                        ToolTip.Tip="Send keep-alive every N seconds to prevent idle disconnects (0 to disable)" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Idle Timeout (min)" Foreground="#aaaaaa"
                                        FontSize="12" />
                                    <TextBox Text="{Binding IdleTimeoutMinutes}"
                                        Classes="connectionInput"
                                        ToolTip.Tip="Auto-disconnect after N minutes without activity (0 keeps the session open indefinitely)" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#252932" Padding="18,14"
                        BorderBrush="#3c4350" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="{Binding TestStatus}"
                                Foreground="{Binding TestStatusColor}" TextWrapping="Wrap"
                                VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="10">
                                <Button Content="Cancel"
                                    Command="{Binding HideConnectionModalCommand}"
                                    Classes="neutralButton" Padding="15,8"
                                    CornerRadius="4" />
                                <Button Content="Test Connection" Classes="primaryButton"
                                    Command="{Binding TestConnectionCommand}" Padding="15,8" CornerRadius="4" />
                                <Button Content="Save Connection"
                                    Command="{Binding SaveConnectionCommand}"
                                    IsEnabled="{Binding IsTestSuccessful}" Classes="successButton" Padding="15,8" CornerRadius="4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Delete Confirmation Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsDeleteConfirmModalVisible}"
            ZIndex="101">
            <Border Classes="modalCard" Width="350" Padding="25">
                <StackPanel Spacing="20">
                    <TextBlock Text="Delete Connection?" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to delete '" />
                        <Run Text="{Binding ProfileToDelete.Name}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                            Classes="dangerButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Bookmark Delete Confirmation Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsBookmarkDeleteConfirmModalVisible}"
            ZIndex="102">
            <Border Classes="modalCard" Width="380" Padding="25">
                <StackPanel Spacing="20">
                    <TextBlock Text="Delete Bookmark?" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to delete the bookmark for '" />
                        <Run Text="{Binding BookmarkToDelete.Path}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelRemoveBookmarkCommand}"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Delete" Command="{Binding ConfirmRemoveBookmarkCommand}"
                            Classes="dangerButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Close Tab Confirmation Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsCloseConfirmModalVisible}" ZIndex="103">
            <Border Classes="modalCard" Width="350" Padding="25">
                <StackPanel Spacing="20">
                    <TextBlock Text="Close Tab?" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#e0e0e0" />
                    <TextBlock Foreground="#aaaaaa" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Are you sure you want to close '" />
                        <Run Text="{Binding TabToClose.Title}" FontWeight="SemiBold"
                            Foreground="#e0e0e0" />
                        <Run Text="'?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCloseTabCommand}"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Close Session" Command="{Binding ConfirmCloseTabCommand}"
                            Classes="dangerButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Bulk Close Tabs Confirmation Modal (Close All / Others / Left / Right, from the tab context menu) -->
        <Border Classes="modalScrim" IsVisible="{Binding IsBulkCloseConfirmModalVisible}" ZIndex="104">
            <Border Classes="modalCard" Width="350" Padding="25">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding BulkCloseTitle}" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#e0e0e0" />
                    <TextBlock Text="{Binding BulkCloseMessage}" Foreground="#aaaaaa" FontSize="14"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelBulkCloseCommand}"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Close" Command="{Binding ConfirmBulkCloseCommand}"
                            Classes="dangerButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Rename File Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsRenameModalVisible}" ZIndex="105">
            <Border Classes="modalCard" Width="400" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Text="Rename File" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#e0e0e0" />

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <TextBlock Text="New Name" Foreground="#aaaaaa" FontSize="13" />
                    <TextBox x:Name="RenameTextBox" Text="{Binding RenameModalText}"
                        PlaceholderText="Enter new filename" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Cancel" Click="CancelRename_Click" Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Rename" Click="ConfirmRename_Click" Classes="successButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- File Properties Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsFilePropertiesModalVisible}"
            ZIndex="106">
            <Border Classes="modalCard" Width="450" Padding="25">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="File Properties" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                            Foreground="#e0e0e0" VerticalAlignment="Center" />
                        <Button Content="✕" Click="ClosePropertiesModal_Click"
                            Background="Transparent" Foreground="#888" HorizontalAlignment="Right"
                            FontSize="16" BorderThickness="0" />
                    </Grid>

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Name:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedFileProperties.Name}"
                                Foreground="#e0e0e0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Type:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.TypeDisplay}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Size:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.SizeDisplay}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Modified:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.ModifiedDisplay}"
                                Foreground="#e0e0e0" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Permissions:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.Permissions}"
                                Foreground="#e0e0e0" FontFamily="{StaticResource TermoxMonoFontFamily}"
                                FontSize="12" />
                        </Grid>

                        <Grid ColumnDefinitions="120, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="Full Path:" Foreground="#aaaaaa"
                                FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                Text="{Binding SelectedFileProperties.FullName}"
                                Foreground="#e0e0e0" TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding SelectedFileProperties.FullName}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,15,0,0">
                        <Button Content="Close" Click="ClosePropertiesModal_Click" Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- File Preview Modal (intentionally heavier scrim/shadow and a distinct card style — larger surface, kept out of the standard modalCard class) -->
        <Border Classes="modalScrim" Background="{StaticResource TermoxHeavyScrimBrush}"
            IsVisible="{Binding IsFilePreviewModalVisible}" ZIndex="107">
            <Border Background="#202124" BorderBrush="#4f5b6b" BorderThickness="1" CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="900" Height="650" BoxShadow="0 18 45 0 #88000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Background="#292d35" Padding="22,16"
                        BorderBrush="#3c4350" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#2f80c9"
                                VerticalAlignment="Center">
                                <TextBlock Text="◉" Foreground="White" FontSize="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="FILE PREVIEW" Foreground="#91bff0" FontSize="10"
                                    FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FilePreviewName}" FontWeight="SemiBold" FontSize="{StaticResource TermoxTitleFontSize}"
                                    Foreground="#f3f5f7" TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding FilePreviewName}" />
                                <TextBlock Text="{Binding FilePreviewDetails}" Foreground="#9aa4b2"
                                    FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Click="ClosePreviewModal_Click"
                                Background="Transparent" Foreground="#aeb7c4" HorizontalAlignment="Right"
                                VerticalAlignment="Top" FontSize="17" BorderThickness="0"
                                Padding="8" ToolTip.Tip="Close preview" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="18" Background="#17191d" BorderBrush="#343b46"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <edit:TextEditor Document="{Binding FilePreviewDocument}"
                            IsReadOnly="True" ShowLineNumbers="True"
                            FontFamily="{StaticResource TermoxMonoFontFamily}"
                            FontSize="13" Background="#17191d" Foreground="#d8dee9"
                            Padding="10,8" KeyDown="PreviewEditor_KeyDown">
                            <edit:TextEditor.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="PreviewEditor_Copy_Click" />
                                </ContextMenu>
                            </edit:TextEditor.ContextMenu>
                        </edit:TextEditor>
                    </Border>

                    <Border Grid.Row="2" Background="#292d35" Padding="18,12"
                        BorderBrush="#3c4350" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" Foreground="#63d297" FontSize="11" />
                                <TextBlock Text="Read-only preview" Foreground="#b7c0cc" FontSize="11"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Copy All" Click="CopyPreview_Click"
                                Classes="infoButton" Padding="16,8"
                                CornerRadius="5" BorderThickness="0" ToolTip.Tip="Copy the full preview to the system clipboard" />
                            <Button Grid.Column="2" Content="Close Preview" Click="ClosePreviewModal_Click"
                                Classes="neutralButton" Padding="16,8"
                                CornerRadius="5" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Host Key Confirmation Modal (warning-colored border is deliberate, kept as an override) -->
        <Border Classes="modalScrim" IsVisible="{Binding IsHostKeyConfirmModalVisible}" ZIndex="108">
            <Border Classes="modalCard" BorderBrush="{StaticResource TermoxWarningBrush}"
                Width="520" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Text="Verify Host Key" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                        Foreground="#f39c12" />
                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,5" />
                    <TextBlock Text="{Binding HostKeyConfirmMessage}" Foreground="#d0d0d0"
                        TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    <TextBlock Text="Connecting is refused until you confirm this fingerprint."
                        Foreground="#888" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,10,0,0">
                        <Button Content="Reject" Command="{Binding RejectHostKeyCommand}"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Trust This Host"
                            Command="{Binding ConfirmHostKeyCommand}" Classes="warningButton" Padding="15,8" CornerRadius="4" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- File Permissions Editor Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsPermissionsModalVisible}" ZIndex="109">
            <Border Classes="modalCard" Width="500" Padding="25">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Edit File Permissions" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                            Foreground="#e0e0e0" VerticalAlignment="Center" />
                        <Button Content="✕" Click="ClosePermissionsModal_Click"
                            Background="Transparent" Foreground="#888" HorizontalAlignment="Right"
                            FontSize="16" BorderThickness="0" />
                    </Grid>

                    <Rectangle Height="1" Fill="#444" Margin="0,5,0,10" />

                    <TextBlock Text="File:" Foreground="#aaaaaa" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedFileForPermissions.Name}" Foreground="#e0e0e0"
                        FontSize="13" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="Current Permissions:" Foreground="#aaaaaa" FontSize="13"
                        FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelectedFileForPermissions.Permissions}"
                        Foreground="#e0e0e0" FontFamily="{StaticResource TermoxMonoFontFamily}"
                        FontSize="14" />

                    <StackPanel Spacing="10" Margin="0,15,0,0">
                        <TextBlock Text="Set Permissions (Octal):" Foreground="#aaaaaa"
                            FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="PermissionsInput"
                            PlaceholderText="e.g., 755, 644, 777" Text="755"
                            ToolTip.Tip="Enter 3-digit octal notation (0-7 for each digit)" />

                        <StackPanel Spacing="5">
                            <TextBlock Text="Common Presets:" Foreground="#aaaaaa" FontSize="11" />
                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="5">
                                <Button Grid.Column="0" Content="644" Click="SetPermissions_Click"
                                    Tag="644" Classes="neutralButton" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="1" Content="755" Click="SetPermissions_Click"
                                    Tag="755" Classes="neutralButton" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="2" Content="777" Click="SetPermissions_Click"
                                    Tag="777" Classes="neutralButton" Padding="8,6"
                                    CornerRadius="3" FontSize="11" Margin="0,0,2,0" />
                                <Button Grid.Column="3" Content="600" Click="SetPermissions_Click"
                                    Tag="600" Classes="neutralButton" Padding="8,6"
                                    CornerRadius="3" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,15,0,0">
                        <Button Content="Cancel" Click="ClosePermissionsModal_Click"
                            Classes="neutralButton" Padding="15,8" CornerRadius="4" />
                        <Button Content="Apply" Click="ApplyPermissions_Click" Classes="successButton" Padding="15,8" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- About Dialog Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsAboutDialogVisible}" ZIndex="110">
            <Border Classes="modalCard" Width="600" MaxHeight="700" Padding="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Image Source="/Assets/Icons/company-logo.png" Width="64" Height="64"
                                    Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TERMOX" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                                        Foreground="#e0e0e0" />
                                    <TextBlock Text="SSH &amp; SFTP workspace" FontSize="14"
                                        Foreground="#aaa" Margin="0,5,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="✕" Click="CloseAboutDialog_Click"
                                Background="Transparent" Foreground="#888"
                                HorizontalAlignment="Right" FontSize="18" BorderThickness="0"
                                Padding="10" />
                        </Grid>

                        <Rectangle Height="1" Fill="#444" Margin="0,10,0,0" />

                        <!-- Product identity -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="The Termox project" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Text="TERMOX" FontSize="16"
                                FontWeight="Bold" Foreground="#e0e0e0" />
                            <TextBlock
                                Text="A focused, cross-platform workspace for secure SSH connections, terminal sessions, SFTP file management, and network utilities."
                                Foreground="#aaa" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Product details -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="Product" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Version " />
                                <Run Text="{Binding ApplicationVersion}" />
                                <Run Text="&#10;" />
                                <Run Text="Built for developers, operators, and anyone who works across remote systems." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Tech Stack -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="Technology Stack" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="11" TextWrapping="Wrap">
                                <Run
                                    Text="Built with Avalonia UI, SSH.NET, and .NET 10.0&#10;Cross-platform support: Windows, macOS, Linux" />
                            </TextBlock>
                        </StackPanel>

                        <!-- User Manual link -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="Documentation" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Text="Open User Manual →" Foreground="#5bc0de" FontSize="12"
                                Cursor="Hand" PointerPressed="OpenUserManualFromAbout_Click" />
                        </StackPanel>

                        <!-- License -->
                        <StackPanel Spacing="8" Margin="0,15,0,0">
                            <TextBlock Text="License" Foreground="#888" FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="11" TextWrapping="Wrap">
                                <Run
                                    Text="MIT License - © 2026 The Termox Project&#10;See LICENSE file for full terms." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- User Manual Dialog Modal -->
        <Border Classes="modalScrim" IsVisible="{Binding IsUserManualDialogVisible}" ZIndex="111">
            <Border Classes="modalCard" Width="640" MaxHeight="720" Padding="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="User Manual" FontWeight="Bold" FontSize="{StaticResource TermoxTitleFontSize}"
                                    Foreground="#e0e0e0" />
                                <TextBlock Text="How to use Termox" FontSize="13"
                                    Foreground="#aaa" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="✕" Click="CloseUserManualDialog_Click"
                                Background="Transparent" Foreground="#888"
                                HorizontalAlignment="Right" FontSize="18" BorderThickness="0"
                                Padding="10" />
                        </Grid>

                        <Rectangle Height="1" Fill="#444" Margin="0,10,0,0" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Sessions" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Save SSH connection profiles (host, port, credentials, and host-key fingerprint) from the Sessions panel, then reconnect with one click. Each saved connection opens in its own tab." />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Bookmarks" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Pin frequently used connections to Bookmarks for quick access without scrolling through the full session list." />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Tools" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Run DNS lookups, port scans, pings, GPG key management, and server-stats checks from the Tools panel, independent of any open terminal session." />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="SFTP" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Browse, upload, download, rename, and edit remote files against a saved connection profile from the SFTP tab." />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Helm (AI Assistant)" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Open the Chat tab and point it at your own OpenAI-compatible endpoint (base URL, API key, model) in the settings drawer. Ask it to inspect or operate on your saved connections in plain language — it can run commands, browse files, check DNS, and more. Read-only actions run automatically; anything that changes state asks for your approval first. Past conversations are saved locally and encrypted at rest — reopen one from the History panel inside the Chat tab." />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Security" Foreground="#5bc0de" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Foreground="#ccc" FontSize="12" TextWrapping="Wrap"
                                Text="Host-key fingerprints are pinned per saved profile the first time you connect. A mismatch on a later connection is flagged rather than silently trusted, and Helm refuses to open a connection to any profile that hasn't been pinned yet." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Panel>
</Window>
